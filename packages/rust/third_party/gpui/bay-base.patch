+const SYSTEM_UI_FAMILY: &str = ".AppleSystemUIFont";
+
+const FONT_KIT_WEIGHT_MAPPING: [f32; 9] = [-0.7, -0.5, -0.23, 0.0, 0.2, 0.3, 0.4, 0.6, 0.8];
