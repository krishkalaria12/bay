+            .flat_map(|bytes| family_names_in_font_data(bytes))
+            .collect::<Vec<_>>();
+        self.inner.add_fonts(fonts)?;
+        self.memory_families.write().extend(families);
+        self.medium_weights.write().clear();
+        Ok(())
+    }
