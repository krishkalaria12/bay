+
+fn message_time_since_boot(message_time: i32, tick_count: u64) -> Duration {
+    let age = (tick_count as u32).wrapping_sub(message_time as u32);
+    Duration::from_millis(tick_count.saturating_sub(u64::from(age)))
+}
