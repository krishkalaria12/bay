+    impl Render for StretchedView {
+        fn render(&mut self, _: &mut Window, _: &mut Context<Self>) -> impl IntoElement {
+            let (x, y) = self.scale_xy;
+            div().size_full().child(
+                div()
+                    .absolute()
+                    .left(px(100.))
+                    .top(px(100.))
+                    .w(px(200.))
+                    .h(px(100.))
+                    .scale_xy(x, y)
+                    .rotate(Radians(self.angle))
+                    .child(self.view.clone()),
+            )
+        }
+    }
