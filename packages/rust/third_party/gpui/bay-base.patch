+        unsafe {
+            let (radius, corners, mask) = match self {
+                Self::Square => (0., 15, None),
+                Self::Rounded { radius, corners } => (radius, corners, None),
+                Self::Masked {
+                    frame,
+                    radius,
+                    corners,
+                } => {
+                    let mask = new_layer();
+                    let [x, y, width, height] = frame;
+                    let frame = NSRect::new(NSPoint::new(x, y), NSSize::new(width, height));
