+                container: placement.bounds,
+                frame: placement.view,
+                radii,
+            }
+        } else if fills(x, width, bounds_width) && fills(y, height, bounds_height) {
+            Self::Rounded { radius, corners }
+        } else {
+            Self::Masked {
+                frame: placement.view,
+                radius,
+                corners,
+            }
+        }
+    }
