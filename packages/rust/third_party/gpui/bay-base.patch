+    struct ClaimingPinchHolder {
+        view: NativeView,
+        claims: bool,
+    }
+
+    impl Render for ClaimingPinchHolder {
+        fn render(&mut self, _: &mut Window, cx: &mut Context<Self>) -> impl IntoElement {
+            div().size_full().child(
+                div()
+                    .absolute()
+                    .left(px(50.))
+                    .top(px(50.))
+                    .size(px(100.))
+                    .on_pinch(cx.listener(|this, _: &crate::PinchEvent, _, cx| {
+                        if this.claims {
+                            cx.stop_propagation();
+                        }
+                    }))
+                    .child(self.view.clone()),
+            )
+        }
+    }
