+                let bounds = Bounds {
+                    origin: point(px(20.), px(20.)),
+                    size: size(px(8.), px(8.)),
+                };
+                window.with_rotation(bounds.center(), crate::radians(1.), |window| {
+                    window
+                        .paint_image_mask(
+                            bounds,
+                            image,
+                            0,
+                            crate::TransformationMatrix::unit(),
+                            rgb(0x0000ff).into(),
+                        )
+                        .unwrap();
+                });
+            },
+        ))
+    }
+}
+
+#[crate::test]
+fn an_image_mask_turns_as_a_monochrome_sprite(cx: &mut TestAppContext) {
+    let (_, cx) = cx.add_window_view(|_, _| SpinningMask);
+    cx.run_until_parked();
+    let sprite = sprite(cx);
+    let scale_factor = cx.update(|window, _| window.scale_factor());
+    let center = 24. * scale_factor;
+    let middle = sprite.transformation.apply(point(px(center), px(center)));
+    assert!((middle.x.0 - center).abs() < 1e-3 && (middle.y.0 - center).abs() < 1e-3);
+    let (sin, cos) = 1f32.sin_cos();
+    assert!((sprite.transformation.rotation_scale[0][0] - cos).abs() < 1e-5);
+    assert!((sprite.transformation.rotation_scale[1][0] - sin).abs() < 1e-5);
+    assert_eq!(sprite.color, crate::Hsla::from(rgb(0x0000ff)));
+}
+
+struct Stretched {
+    scale: Option<f32>,
+    scale_xy: Option<(f32, f32)>,
+    rounded: bool,
+    clicks: Rc<Cell<usize>>,
+}
+
+impl Render for Stretched {
+    fn render(&mut self, _: &mut Window, _: &mut Context<Self>) -> impl IntoElement {
+        let clicks = self.clicks.clone();
+        let mut element = div()
+            .id("stretched")
+            .absolute()
+            .left(px(150.))
+            .top(px(150.))
+            .w(px(100.))
+            .h(px(40.))
+            .border_2()
+            .border_color(rgb(0x00ff00))
+            .bg(rgb(0xff0000))
+            .shadow_md()
+            .on_click(move |_, _, _| clicks.set(clicks.get() + 1))
+            .child(
+                svg()
+                    .data(SQUARE_SVG)
+                    .size(px(16.))
+                    .text_color(rgb(0x0000ff)),
+            );
+        if self.rounded {
+            element = element.rounded(px(10.));
+        }
+        if let Some(scale) = self.scale {
+            element = element.scale(scale);
+        }
+        if let Some((x, y)) = self.scale_xy {
+            element = element.scale_xy(x, y);
+        }
+        div().size_full().child(element)
+    }
+}
+
+fn open_stretched(
+    scale: Option<f32>,
+    scale_xy: Option<(f32, f32)>,
+    rounded: bool,
+    cx: &mut TestAppContext,
+) -> (Rc<Cell<usize>>, &mut VisualTestContext) {
+    let clicks = Rc::new(Cell::new(0));
+    let (_, cx) = cx.add_window_view({
+        let clicks = clicks.clone();
+        move |_, _| Stretched {
+            scale,
+            scale_xy,
+            rounded,
+            clicks,
+        }
+    });
+    cx.run_until_parked();
+    (clicks, cx)
+}
+
+#[crate::test]
+fn an_even_scale_xy_draws_exactly_as_the_uniform_scale(cx: &mut TestAppContext) {
+    for rounded in [false, true] {
+        let uniform = full_scene_dump(open_stretched(Some(0.5), None, rounded, cx).1);
+        let even = full_scene_dump(open_stretched(None, Some((0.5, 0.5)), rounded, cx).1);
+        assert_eq!(even, uniform);
+        let composed = full_scene_dump(open_stretched(Some(2.), Some((0.25, 0.25)), rounded, cx).1);
+        assert_eq!(composed, uniform);
+    }
+}
+
+#[crate::test]
+fn a_scale_xy_of_one_leaves_the_scene_unchanged(cx: &mut TestAppContext) {
+    let plain = full_scene_dump(open_stretched(None, None, true, cx).1);
+    let one = full_scene_dump(open_stretched(None, Some((1., 1.)), true, cx).1);
+    assert_eq!(one, plain);
+    struct Unscaled;
+    impl Render for Unscaled {
+        fn render(&mut self, _: &mut Window, _: &mut Context<Self>) -> impl IntoElement {
+            div().size_full().child(crate::canvas(
+                |_, _, _| {},
+                |_, _, window, _| {
+                    window.with_scale_xy(point(px(10.), px(10.)), 1., 1., |_| {});
+                    window.with_transform_xy(
+                        point(px(10.), px(10.)),
+                        1.,
+                        1.,
+                        crate::radians(0.),
+                        |_| {},
+                    );
+                },
+            ))
+        }
+    }
+    let (_, cx) = cx.add_window_view(|_, _| Unscaled);
+    cx.run_until_parked();
+    assert_eq!(full_scene_dump(cx), "[][][][]0");
+}
+
+#[crate::test]
+fn an_unevenly_scaled_element_is_drawn_and_hit_stretched_per_axis(cx: &mut TestAppContext) {
+    let (clicks, cx) = open_stretched(None, Some((0.5, 2.)), false, cx);
+    let (scale_factor, quads, hitboxes, paths) = cx.update(|window, _| {
+        (
+            window.scale_factor(),
+            window.painted_quads(),
+            window
+                .rendered_frame
+                .hitboxes
+                .iter()
+                .map(|hitbox| hitbox.bounds)
+                .collect::<Vec<_>>(),
+            window.rendered_frame.scene.paths.len(),
+        )
+    });
+    assert_eq!(paths, 0, "square corners stay quads");
+    let drawn = quads
+        .iter()
+        .map(|quad| quad.bounds)
+        .reduce(|union, bounds| union.union(&bounds))
+        .unwrap();
+    assert_eq!(drawn, scaled(175., 130., 50., 80., scale_factor));
+    let drawn = Bounds {
+        origin: point(px(175.), px(130.)),
+        size: size(px(50.), px(80.)),
+    };
+    assert!(hitboxes.contains(&drawn), "{hitboxes:?}");
+
+    cx.simulate_click(point(px(180.), px(135.)), Modifiers::none());
+    assert_eq!(clicks.get(), 1, "inside what is drawn, above the layout");
+    cx.simulate_click(point(px(165.), px(170.)), Modifiers::none());
+    assert_eq!(clicks.get(), 1, "inside the layout, beside what is drawn");
+    cx.simulate_click(point(px(220.), px(205.)), Modifiers::none());
+    assert_eq!(clicks.get(), 2);
+
+    let sprite = sprite(cx);
+    assert_eq!(sprite.transformation.rotation_scale, [[0.5, 0.], [0., 2.]]);
+}
+
+#[crate::test]
+fn an_unevenly_scaled_rounded_element_fills_its_quads_as_paths(cx: &mut TestAppContext) {
+    let (_, cx) = open_stretched(None, Some((0.5, 2.)), true, cx);
+    let (rounded_quads, paths) = cx.update(|window, _| {
+        let scene = &window.rendered_frame.scene;
+        (
+            scene
+                .quads
+                .iter()
+                .filter(|quad| quad.corner_radii != Default::default())
+                .count(),
+            scene.paths.len(),
+        )
+    });
+    assert_eq!(rounded_quads, 0);
+    assert_eq!(paths, 2, "a background and a border ring");
+}
diff --git a/third_party/gpui/gpui/src/window/visual_effect.rs b/third_party/gpui/gpui/src/window/visual_effect.rs
new file mode 100644
index 0000000..946e96b
--- /dev/null
+++ b/third_party/gpui/gpui/src/window/visual_effect.rs
@@ -0,0 +1,81 @@
+use crate::{
+    Bounds, Corners, Pixels, VisualEffectBlending, VisualEffectMaterial, VisualEffectRegion,
+    VisualEffectState, Window,
+};
+
+const IMPLICIT_ID: u64 = 1 << 63;
+
+/// A request to show a system material beneath the window's content, made
+/// while painting.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct PaintVisualEffect {
+    /// A stable identifier for the region, or `None` to derive one from the
+    /// element painting it.
+    pub id: Option<u64>,
+    /// Where the material is shown.
+    pub bounds: Bounds<Pixels>,
+    /// The radius of each corner.
+    pub corner_radii: Corners<Pixels>,
+    /// The material shown.
+    pub material: VisualEffectMaterial,
+    /// What the material blurs.
+    pub blending: VisualEffectBlending,
+    /// Whether the material looks active.
+    pub state: VisualEffectState,
+    /// Whether the material uses its emphasized look.
+    pub emphasized: bool,
+}
+
+impl Window {
+    /// Whether the platform shows the system materials painted with
+    /// [`Self::paint_visual_effect`].
+    pub fn composites_visual_effects(&self) -> bool {
+        self.platform_window.composites_visual_effects()
+    }
+
+    /// Shows a system material beneath the window's content within the given
+    /// bounds, clipped to the current content mask. What is painted before it
+    /// there is hidden and what is painted after it is drawn on top.
+    ///
+    /// Nothing is shown while the element is translucent or where the platform
+    /// has no system materials.
+    pub fn paint_visual_effect(&mut self, effect: PaintVisualEffect) {
+        self.invalidator.debug_assert_paint();
+        let opacity = self.element_opacity();
+        if opacity.is_nan() || opacity < 1. || effect.bounds.is_empty() {
+            return;
+        }
+        if !self.composites_visual_effects() {
+            return;
+        }
+        let id = match effect.id {
+            Some(id) => id & !IMPLICIT_ID,
+            None => {
+                let index = self.next_frame.scene.visual_effect_regions.len() as u64 + 1;
+                let scope = self.element_id_stack.hash().as_u64();
+                IMPLICIT_ID | (scope ^ index.wrapping_mul(0x9e37_79b9_7f4a_7c15))
+            }
+        };
+        let corner_radii = Corners {
+            top_left: effect.corner_radii.top_left.max(Pixels::ZERO),
+            top_right: effect.corner_radii.top_right.max(Pixels::ZERO),
+            bottom_right: effect.corner_radii.bottom_right.max(Pixels::ZERO),
+            bottom_left: effect.corner_radii.bottom_left.max(Pixels::ZERO),
+        }
+        .clamp_radii_for_quad_size(effect.bounds.size)
+        .scale(self.scale_factor());
+        self.next_frame
+            .scene
+            .insert_visual_effect(VisualEffectRegion {
+                id,
+                order: 0,
+                bounds: self.snap_bounds(effect.bounds),
+                content_mask: self.snapped_content_mask().bounds,
+                corner_radii,
+                material: effect.material,
+                blending: effect.blending,
+                state: effect.state,
+                emphasized: effect.emphasized,
+            });
+    }
+}
