+
+impl CornerShape {
+    fn new(placement: &Placement, radii: [f64; 4]) -> Self {
+        let [x, y, width, height] = placement.view;
+        let radii = clamped_radii(radii, width, height);
+        let mut corners = 0;
+        let mut radius: f64 = 0.;
