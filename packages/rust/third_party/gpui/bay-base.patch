+fn scaled(x: f32, y: f32, width: f32, height: f32, scale_factor: f32) -> Bounds<ScaledPixels> {
+    Bounds {
+        origin: point(
+            ScaledPixels(x * scale_factor),
+            ScaledPixels(y * scale_factor),
+        ),
+        size: size(
+            ScaledPixels(width * scale_factor),
+            ScaledPixels(height * scale_factor),
+        ),
