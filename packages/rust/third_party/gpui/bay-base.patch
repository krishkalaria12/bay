index 0000000..46952d1
--- /dev/null
+++ b/third_party/gpui/gpui_macos/src/window/external_drop.rs
@@ -0,0 +1,606 @@
+use super::{
+    conclude_drag_operation, dragging_entered, dragging_exited, dragging_updated,
+    native_views::native_view_hit_at, perform_drag_operation, window_state_if_set,
+};
+use gpui::{ExternalItems, ExternalPaths};
+use objc2::{
+    class, msg_send,
+    rc::Retained,
+    runtime::{AnyObject, Bool, ClassBuilder, Sel},
+    sel,
+};
+#[expect(
+    deprecated,
+    reason = "Finder and most drag sources still offer NSFilenamesPboardType, the one type that lists every dragged path at once"
+)]
+use objc2_app_kit::NSFilenamesPboardType;
+use objc2_app_kit::{
+    NSDragOperation, NSPasteboard, NSPasteboardTypeFileURL, NSPasteboardTypeString,
+    NSPasteboardTypeURL, NSView,
+};
+use objc2_foundation::{NSArray, NSPoint, NSString, NSURL};
+use std::{cell::RefCell, path::PathBuf};
+
+/// What a dragging pasteboard holds, read out of AppKit.
+#[derive(Debug, Default)]
+pub(crate) struct DraggedContents {
+    pub filenames: Vec<PathBuf>,
+    pub file_urls: Vec<PathBuf>,
+    pub web_urls: Vec<String>,
+    pub text: Option<String>,
+}
+
+/// What GPUI makes the active drag for a drag from outside the window.
+#[derive(Debug, PartialEq, Eq)]
+pub(crate) enum DroppedPayload {
+    Paths(ExternalPaths),
+    Items(ExternalItems),
+}
+
+/// Files win and arrive as [`ExternalPaths`], as they always have; otherwise
+/// web URLs and text arrive together as [`ExternalItems`].
+pub(crate) fn decode_dragged_contents(contents: DraggedContents) -> Option<DroppedPayload> {
+    let DraggedContents {
+        filenames,
+        file_urls,
+        web_urls,
+        text,
+    } = contents;
+    let paths = if filenames.is_empty() {
+        file_urls
+    } else {
+        filenames
+    };
+    if !paths.is_empty() {
+        return Some(DroppedPayload::Paths(ExternalPaths(
+            paths.into_iter().collect(),
+        )));
+    }
+    let items = ExternalItems {
+        paths: Vec::new(),
+        urls: web_urls
+            .into_iter()
+            .map(|url| url.trim().to_owned())
+            .filter(|url| !url.is_empty())
+            .collect(),
+        text: text.filter(|text| !text.is_empty()),
+    };
+    (!items.is_empty()).then_some(DroppedPayload::Items(items))
+}
+
+/// The pasteboard types GPUI views and windows register to receive drags of.
+pub(super) fn dragged_types() -> Retained<NSArray<NSString>> {
+    #[expect(
+        deprecated,
+        reason = "Finder and most drag sources still offer NSFilenamesPboardType, the one type that lists every dragged path at once"
+    )]
+    let filenames = unsafe { NSFilenamesPboardType };
+    unsafe {
+        NSArray::from_slice(&[
+            filenames,
+            NSPasteboardTypeFileURL,
+            NSPasteboardTypeURL,
+            NSPasteboardTypeString,
+        ])
+    }
+}
+
+/// Reads and decodes what the drag behind an `NSDraggingInfo` carries.
+pub(super) fn payload_from_dragging_info(dragging_info: *mut AnyObject) -> Option<DroppedPayload> {
+    let pasteboard: *mut NSPasteboard = unsafe { msg_send![dragging_info, draggingPasteboard] };
+    let pasteboard = unsafe { pasteboard.as_ref() }?;
+    decode_dragged_contents(read_pasteboard(pasteboard))
+}
+
+pub(crate) fn read_pasteboard(pasteboard: &NSPasteboard) -> DraggedContents {
+    let mut contents = DraggedContents::default();
+    #[expect(
+        deprecated,
+        reason = "Finder and most drag sources still offer NSFilenamesPboardType, the one type that lists every dragged path at once"
+    )]
+    let filenames: *mut AnyObject =
+        unsafe { msg_send![pasteboard, propertyListForType: NSFilenamesPboardType] };
+    let is_array: bool = !filenames.is_null()
+        && unsafe { msg_send![filenames, isKindOfClass: objc2::class!(NSArray)] };
+    if is_array {
+        let filenames = unsafe { &*filenames.cast::<NSArray<AnyObject>>() };
+        for filename in filenames.iter() {
+            if let Some(filename) = filename.downcast_ref::<NSString>() {
+                contents.filenames.push(PathBuf::from(filename.to_string()));
+            }
+        }
+    }
+    let items: *mut NSArray<AnyObject> = unsafe { msg_send![pasteboard, pasteboardItems] };
+    if let Some(items) = unsafe { items.as_ref() } {
+        for item in items.iter() {
+            let item: &AnyObject = &item;
+            for kind in unsafe { [NSPasteboardTypeFileURL, NSPasteboardTypeURL] } {
+                let string: *mut NSString = unsafe { msg_send![item, stringForType: kind] };
+                let Some(string) = (unsafe { string.as_ref() }) else {
+                    continue;
+                };
+                match file_path_of_url(string) {
+                    Some(path) => contents.file_urls.push(path),
+                    None if kind == unsafe { NSPasteboardTypeURL } => {
+                        contents.web_urls.push(string.to_string())
+                    }
+                    None => {}
+                }
+                break;
+            }
+        }
+    }
+    contents.text =
+        unsafe { pasteboard.stringForType(NSPasteboardTypeString) }.map(|text| text.to_string());
+    contents
+}
+
+fn file_path_of_url(string: &NSString) -> Option<PathBuf> {
+    let url = NSURL::URLWithString(string)?;
+    if !url.isFileURL() {
+        return None;
+    }
+    let url = url.filePathURL().unwrap_or(url);
+    url.path().map(|path| PathBuf::from(path.to_string()))
+}
+
+enum DragTarget {
+    Gpui,
+    Native {
+        view: Retained<NSView>,
+        entered: NSDragOperation,
+    },
+}
+
+thread_local! {
+    static HOSTED_DRAG_TARGET: RefCell<Option<(usize, DragTarget)>> = const { RefCell::new(None) };
+}
+
+/// Adds the drag destination methods to the GPUI view.
+///
+/// A hosted GPUI view is registered for drags itself, since its host window
+/// isn't a GPUI window. AppKit picks the frontmost registered view under the
+/// pointer without asking `hitTest:`, so the GPUI view would take drags meant
+/// for the native views beneath it. These methods hand a drag over such a view
+/// to the view inside it that is registered for the drag, and give GPUI the rest.
+pub(super) fn add_view_methods(decl: &mut ClassBuilder) {
+    unsafe {
+        decl.add_method(
+            sel!(draggingEntered:),
+            view_dragging_entered as extern "C" fn(_, Sel, *mut AnyObject) -> NSDragOperation,
+        );
+        decl.add_method(
+            sel!(draggingUpdated:),
+            view_dragging_updated as extern "C" fn(_, Sel, *mut AnyObject) -> NSDragOperation,
+        );
+        decl.add_method(
+            sel!(draggingExited:),
+            view_dragging_exited as extern "C" fn(_, Sel, *mut AnyObject),
+        );
+        decl.add_method(
+            sel!(prepareForDragOperation:),
+            view_prepare_for_drag_operation as extern "C" fn(_, Sel, *mut AnyObject) -> Bool,
+        );
+        decl.add_method(
+            sel!(performDragOperation:),
+            view_perform_drag_operation as extern "C" fn(_, Sel, *mut AnyObject) -> Bool,
+        );
+        decl.add_method(
+            sel!(concludeDragOperation:),
+            view_conclude_drag_operation as extern "C" fn(_, Sel, *mut AnyObject),
+        );
+        decl.add_method(
+            sel!(draggingEnded:),
+            view_dragging_ended as extern "C" fn(_, Sel, *mut AnyObject),
+        );
+    }
+}
+
+fn native_destination(this: &AnyObject, dragging_info: *mut AnyObject) -> Option<Retained<NSView>> {
+    let window_state = unsafe { window_state_if_set(this) }?;
+    let location: NSPoint = unsafe { msg_send![dragging_info, draggingLocation] };
+    let pasteboard: *mut NSPasteboard = unsafe { msg_send![dragging_info, draggingPasteboard] };
+    let types = unsafe { pasteboard.as_ref() }?.types()?;
+    let (container, hit) = native_view_hit_at(&window_state, location)?;
+    registered_destination(hit, &container, &types)
+}
+
+/// The innermost view from `hit` up to and including `container` that is
+/// registered for one of `types`, which is the view AppKit would make the drag
+/// destination were the GPUI view not registered above it.
+fn registered_destination(
+    hit: Retained<NSView>,
+    container: &NSView,
+    types: &NSArray<NSString>,
+) -> Option<Retained<NSView>> {
+    let mut candidate = Some(hit);
+    while let Some(view) = candidate {
+        let registered = view.registeredDraggedTypes();
+        if types.iter().any(|kind| registered.containsObject(&kind)) {
+            return Some(view);
+        }
+        if std::ptr::eq(&*view, container) {
+            break;
+        }
+        candidate = unsafe { view.superview() };
+    }
+    None
+}
+
+fn take_target(this: &AnyObject) -> Option<DragTarget> {
+    HOSTED_DRAG_TARGET.with_borrow_mut(|target| {
+        if target
+            .as_ref()
+            .is_some_and(|(view, _)| *view == this as *const AnyObject as usize)
+        {
+            target.take().map(|(_, target)| target)
+        } else {
+            None
+        }
+    })
+}
+
+fn set_target(this: &AnyObject, target: DragTarget) {
+    HOSTED_DRAG_TARGET
+        .with_borrow_mut(|slot| *slot = Some((this as *const AnyObject as usize, target)));
+}
+
+fn implements(view: &NSView, selector: Sel) -> bool {
+    let object: &AnyObject = view;
+    let Some(method) = object.class().instance_method(selector) else {
+        return unsafe { msg_send![view, respondsToSelector: selector] };
+    };
+    class!(NSView)
+        .instance_method(selector)
+        .is_none_or(|default| method.implementation() as usize != default.implementation() as usize)
+}
+
+fn enter(this: &AnyObject, selector: Sel, dragging_info: *mut AnyObject) -> NSDragOperation {
+    match native_destination(this, dragging_info) {
+        Some(view) => {
+            let entered = if implements(&view, sel!(draggingEntered:)) {
+                unsafe { msg_send![&*view, draggingEntered: dragging_info] }
+            } else {
+                NSDragOperation::None
+            };
+            set_target(this, DragTarget::Native { view, entered });
+            entered
+        }
+        None => {
+            set_target(this, DragTarget::Gpui);
+            dragging_entered(this, selector, dragging_info)
+        }
+    }
+}
+
+fn leave(this: &AnyObject, target: DragTarget, selector: Sel, dragging_info: *mut AnyObject) {
+    match target {
+        DragTarget::Native { view, .. } => {
+            if implements(&view, sel!(draggingExited:)) {
+                let () = unsafe { msg_send![&*view, draggingExited: dragging_info] };
+            }
+        }
+        DragTarget::Gpui => dragging_exited(this, selector, dragging_info),
+    }
+}
+
+extern "C" fn view_dragging_entered(
+    this: &AnyObject,
+    selector: Sel,
+    dragging_info: *mut AnyObject,
+) -> NSDragOperation {
+    if let Some(stale) = take_target(this) {
+        leave(this, stale, selector, dragging_info);
+    }
+    enter(this, selector, dragging_info)
+}
+
+extern "C" fn view_dragging_updated(
+    this: &AnyObject,
+    selector: Sel,
+    dragging_info: *mut AnyObject,
+) -> NSDragOperation {
+    let destination = native_destination(this, dragging_info);
+    match (take_target(this), destination) {
+        (Some(DragTarget::Native { view, entered }), Some(destination)) if view == destination => {
+            let operation = if implements(&view, sel!(draggingUpdated:)) {
+                unsafe { msg_send![&*view, draggingUpdated: dragging_info] }
+            } else {
+                entered
+            };
+            set_target(this, DragTarget::Native { view, entered });
+            operation
+        }
+        (Some(DragTarget::Gpui), None) => {
+            set_target(this, DragTarget::Gpui);
+            dragging_updated(this, selector, dragging_info)
+        }
+        (current, _) => {
+            if let Some(current) = current {
+                leave(this, current, selector, dragging_info);
+            }
+            enter(this, selector, dragging_info)
+        }
+    }
+}
+
+extern "C" fn view_dragging_exited(this: &AnyObject, selector: Sel, dragging_info: *mut AnyObject) {
+    if let Some(target) = take_target(this) {
+        leave(this, target, selector, dragging_info);
+    }
+}
+
+fn with_native_target<R>(this: &AnyObject, f: impl FnOnce(&NSView) -> R) -> Option<R> {
+    let view = HOSTED_DRAG_TARGET.with_borrow(|target| match target {
+        Some((owner, DragTarget::Native { view, .. }))
+            if *owner == this as *const AnyObject as usize =>
+        {
+            Some(view.clone())
+        }
+        _ => None,
+    })?;
+    Some(f(&view))
+}
+
+extern "C" fn view_prepare_for_drag_operation(
+    this: &AnyObject,
+    _: Sel,
+    dragging_info: *mut AnyObject,
+) -> Bool {
+    with_native_target(this, |view| {
+        if implements(view, sel!(prepareForDragOperation:)) {
+            unsafe { msg_send![view, prepareForDragOperation: dragging_info] }
+        } else {
+            Bool::YES
+        }
+    })
+    .unwrap_or(Bool::YES)
+}
+
+extern "C" fn view_perform_drag_operation(
+    this: &AnyObject,
+    selector: Sel,
+    dragging_info: *mut AnyObject,
+) -> Bool {
+    with_native_target(this, |view| {
+        if implements(view, sel!(performDragOperation:)) {
+            unsafe { msg_send![view, performDragOperation: dragging_info] }
+        } else {
+            Bool::NO
+        }
+    })
+    .unwrap_or_else(|| perform_drag_operation(this, selector, dragging_info))
+}
+
+extern "C" fn view_conclude_drag_operation(
+    this: &AnyObject,
+    selector: Sel,
+    dragging_info: *mut AnyObject,
+) {
+    match take_target(this) {
+        Some(DragTarget::Native { view, entered }) => {
+            if implements(&view, sel!(concludeDragOperation:)) {
+                let () = unsafe { msg_send![&*view, concludeDragOperation: dragging_info] };
+            }
+            set_target(this, DragTarget::Native { view, entered });
+        }
+        Some(DragTarget::Gpui) => conclude_drag_operation(this, selector, dragging_info),
+        None => {}
+    }
+}
+
+extern "C" fn view_dragging_ended(this: &AnyObject, _: Sel, dragging_info: *mut AnyObject) {
+    if let Some(DragTarget::Native { view, .. }) = take_target(this)
+        && implements(&view, sel!(draggingEnded:))
+    {
+        let () = unsafe { msg_send![&*view, draggingEnded: dragging_info] };
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use objc2::runtime::ProtocolObject;
+    use objc2_app_kit::NSPasteboardWriting;
+
+    fn decode(contents: DraggedContents) -> Option<DroppedPayload> {
+        decode_dragged_contents(contents)
+    }
+
+    fn paths(paths: &[&str]) -> Option<DroppedPayload> {
+        Some(DroppedPayload::Paths(ExternalPaths(
+            paths.iter().map(PathBuf::from).collect(),
+        )))
+    }
+
+    fn items(urls: &[&str], text: Option<&str>) -> Option<DroppedPayload> {
+        Some(DroppedPayload::Items(ExternalItems {
+            paths: Vec::new(),
+            urls: urls.iter().map(|url| url.to_string()).collect(),
+            text: text.map(str::to_owned),
+        }))
+    }
+
+    #[test]
+    fn files_win_over_urls_and_text() {
+        let payload = decode(DraggedContents {
+            filenames: vec!["/tmp/a.txt".into(), "/tmp/b".into()],
+            file_urls: vec!["/tmp/a.txt".into()],
+            web_urls: vec!["https://example.com/".into()],
+            text: Some("hello".into()),
+        });
+        assert_eq!(payload, paths(&["/tmp/a.txt", "/tmp/b"]));
+    }
+
+    #[test]
+    fn file_urls_become_paths_without_filenames() {
+        let payload = decode(DraggedContents {
+            file_urls: vec!["/tmp/a b.txt".into()],
+            web_urls: vec!["https://example.com/".into()],
+            ..Default::default()
+        });
+        assert_eq!(payload, paths(&["/tmp/a b.txt"]));
+    }
+
+    #[test]
+    fn urls_arrive_with_their_text() {
+        let payload = decode(DraggedContents {
+            web_urls: vec![
+                " https://a.example/ ".into(),
+                "".into(),
+                "https://b.example/".into(),
+            ],
+            text: Some("Example".into()),
+            ..Default::default()
+        });
+        assert_eq!(
+            payload,
+            items(
+                &["https://a.example/", "https://b.example/"],
+                Some("Example")
+            )
+        );
+    }
+
+    #[test]
+    fn text_alone_is_text_and_empty_is_nothing() {
+        assert_eq!(
+            decode(DraggedContents {
+                text: Some("https://not-a-url-type.example".into()),
+                ..Default::default()
+            }),
+            items(&[], Some("https://not-a-url-type.example"))
+        );
+        assert_eq!(
+            decode(DraggedContents {
+                text: Some(String::new()),
+                ..Default::default()
+            }),
+            None
+        );
+        assert_eq!(decode(DraggedContents::default()), None);
+    }
+
+    fn pasteboard_with(objects: &[Retained<AnyObject>]) -> Retained<NSPasteboard> {
+        let pasteboard = NSPasteboard::pasteboardWithUniqueName();
+        pasteboard.clearContents();
+        let writers = objects
+            .iter()
+            .map(|object| unsafe {
+                Retained::cast_unchecked::<ProtocolObject<dyn NSPasteboardWriting>>(object.clone())
+            })
+            .collect::<Vec<_>>();
+        assert!(pasteboard.writeObjects(&NSArray::from_retained_slice(&writers)));
+        pasteboard
+    }
+
+    fn url(string: &str) -> Retained<AnyObject> {
+        let url = NSURL::URLWithString(&NSString::from_str(string)).unwrap();
+        unsafe { Retained::cast_unchecked(url) }
+    }
+
+    fn file_url(path: &str) -> Retained<AnyObject> {
+        let url = NSURL::fileURLWithPath(&NSString::from_str(path));
+        unsafe { Retained::cast_unchecked(url) }
+    }
+
+    fn string(text: &str) -> Retained<AnyObject> {
+        unsafe { Retained::cast_unchecked(NSString::from_str(text)) }
+    }
+
+    fn read(objects: &[Retained<AnyObject>]) -> Option<DroppedPayload> {
+        let pasteboard = pasteboard_with(objects);
+        let payload = decode_dragged_contents(read_pasteboard(&pasteboard));
+        let () = unsafe { msg_send![&*pasteboard, releaseGlobally] };
+        payload
+    }
+
+    #[test]
+    fn forwards_to_the_innermost_registered_view_inside_the_container() {
+        let new_view = || -> Retained<NSView> { unsafe { msg_send![objc2::class!(NSView), new] } };
+        let outside = new_view();
+        let container = new_view();
+        let page = new_view();
+        let renderer = new_view();
+        outside.addSubview(&container);
+        container.addSubview(&page);
+        page.addSubview(&renderer);
+        let strings = unsafe { NSArray::from_slice(&[NSPasteboardTypeString]) };
+        let files = unsafe { NSArray::from_slice(&[NSPasteboardTypeFileURL]) };
+        outside.registerForDraggedTypes(&strings);
+        page.registerForDraggedTypes(&strings);
+
+        assert_eq!(
+            registered_destination(renderer.clone(), &container, &strings).as_deref(),
+            Some(&*page)
+        );
+        assert_eq!(
+            registered_destination(renderer.clone(), &container, &files),
+            None
+        );
+        page.unregisterDraggedTypes();
+        assert_eq!(
+            registered_destination(renderer, &container, &strings),
+            None,
+            "views outside the native view are never forwarded to"
+        );
+    }
+
+    extern "C" fn copies(_: &AnyObject, _: Sel, _: *mut AnyObject) -> NSDragOperation {
+        NSDragOperation::Copy
+    }
+
+    #[test]
+    fn appkit_defaults_are_not_implementations() {
+        let plain: Retained<NSView> = unsafe { msg_send![objc2::class!(NSView), new] };
+        let mut builder = ClassBuilder::new(c"GPUIExternalDropTestEnteringView", class!(NSView))
+            .expect("a fresh view class");
+        unsafe {
+            builder.add_method(
+                sel!(draggingEntered:),
+                copies as extern "C" fn(_, Sel, *mut AnyObject) -> NSDragOperation,
+            );
+        }
+        let entering: Retained<NSView> = unsafe { msg_send![builder.register(), new] };
+        for selector in [
+            sel!(draggingEntered:),
+            sel!(draggingUpdated:),
+            sel!(draggingExited:),
+            sel!(prepareForDragOperation:),
+            sel!(performDragOperation:),
+            sel!(concludeDragOperation:),
+            sel!(draggingEnded:),
+        ] {
+            assert!(!implements(&plain, selector), "{selector:?}");
+        }
+        assert!(implements(&entering, sel!(draggingEntered:)));
+        assert!(!implements(&entering, sel!(draggingUpdated:)));
+    }
+
+    #[test]
+    fn reads_a_real_pasteboard() {
+        assert_eq!(
+            read(&[file_url("/tmp/gpui drop/a.txt"), file_url("/tmp/b.txt")]),
+            paths(&["/tmp/gpui drop/a.txt", "/tmp/b.txt"])
+        );
+        assert_eq!(
+            read(&[
+                url("https://example.com/a?b=c"),
+                url("https://example.org/")
+            ]),
+            items(&["https://example.com/a?b=c", "https://example.org/"], None)
+        );
+        assert_eq!(
+            read(&[url("https://example.com/"), string("Example")]),
+            items(&["https://example.com/"], Some("Example"))
+        );
+        assert_eq!(
+            read(&[string("plain text")]),
+            items(&[], Some("plain text"))
+        );
+        assert_eq!(
+            read(&[url("https://example.com/"), file_url("/tmp/c.txt")]),
+            paths(&["/tmp/c.txt"])
+        );
+    }
+}
diff --git a/third_party/gpui/gpui_macos/src/window/frame_drawable.rs b/third_party/gpui/gpui_macos/src/window/frame_drawable.rs
new file mode 100644
index 0000000..62915af
--- /dev/null
+++ b/third_party/gpui/gpui_macos/src/window/frame_drawable.rs
@@ -0,0 +1,108 @@
+//! Drawables for frames drawn outside a display link's update.
+//!
+//! `nextDrawable` blocks while every drawable is in flight, so it runs with
+//! the window's lock released: AppKit hit testing and other callbacks only try
+//! the lock and would otherwise fail for as long as it blocks.
+
+use super::{MacWindowState, renderer::Renderer};
+use objc2::{Message, class, msg_send, rc::Retained, runtime::ProtocolObject};
+use objc2_quartz_core::CAMetalDrawable;
+use parking_lot::Mutex;
+
+pub(super) type Drawable = Retained<ProtocolObject<dyn CAMetalDrawable>>;
+
+/// What a frame drawn outside a display link's update draws into.
+pub(super) enum FrameDrawable {
+    /// A display link supplies the drawable, or the renderer has no layer.
+    Supplied,
+    /// A drawable taken from the layer with the lock released.
+    Acquired(Drawable),
+    /// The layer had no drawable to give.
+    Unavailable,
+}
+
+/// Runs `prepare` with `state` locked and then `acquire` with it unlocked.
+/// Returns `None` when `prepare` does.
+pub(super) fn with_unlocked<S, L, R>(
+    state: &Mutex<S>,
+    prepare: impl FnOnce(&mut S) -> Option<L>,
+    acquire: impl FnOnce(L) -> R,
+) -> Option<R> {
+    let prepared = prepare(&mut state.lock())?;
+    Some(acquire(prepared))
+}
+
+/// Takes the layer's next drawable unless a display link supplies one.
+pub(super) fn next_drawable(window_state: &Mutex<MacWindowState>) -> FrameDrawable {
+    let acquired = with_unlocked(
+        window_state,
+        |state| {
+            if state.renderer.is_display_link_attached() {
+                return None;
+            }
+            state.renderer.layer().map(|layer| layer.retain())
+        },
+        |layer| layer.nextDrawable(),
+    );
+    match acquired {
+        None => FrameDrawable::Supplied,
+        Some(Some(drawable)) => FrameDrawable::Acquired(drawable),
+        Some(None) => FrameDrawable::Unavailable,
+    }
+}
+
+/// Draws `scene` into `drawable` the way a display link's frame would, then
+/// leaves the renderer detached again.
+pub(super) fn draw_into(renderer: &mut Renderer, drawable: Drawable, scene: &gpui::Scene) {
+    renderer.set_display_link_attached(true);
+    renderer.set_frame_drawable(Some(drawable));
+    renderer.draw(scene);
+    renderer.set_frame_drawable(None);
+    renderer.set_display_link_attached(false);
+}
+
+/// Runs `f` in an explicit Core Animation transaction, so that a drawable
+/// presented with the transaction and the layer changes made after it reach
+/// the display together.
+pub(super) fn in_transaction<R>(f: impl FnOnce() -> R) -> R {
+    unsafe {
+        let _: () = msg_send![class!(CATransaction), begin];
+    }
+    let result = f();
+    unsafe {
+        let _: () = msg_send![class!(CATransaction), commit];
+    }
+    result
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn the_drawable_is_acquired_with_the_lock_released() {
+        let state = Mutex::new(1);
+        let acquired = with_unlocked(
+            &state,
+            |value| {
+                *value += 1;
+                Some(*value)
+            },
+            |prepared| {
+                assert!(
+                    state.try_lock().is_some(),
+                    "acquiring must not hold the lock"
+                );
+                prepared * 10
+            },
+        );
+        assert_eq!(acquired, Some(20));
+    }
+
+    #[test]
+    fn nothing_is_acquired_when_preparation_declines() {
+        let state = Mutex::new(());
+        let acquired = with_unlocked(&state, |_| None::<()>, |_| unreachable!());
+        assert_eq!(acquired, None);
+    }
+}
diff --git a/third_party/gpui/gpui_macos/src/window/gesture_forwarding.rs b/third_party/gpui/gpui_macos/src/window/gesture_forwarding.rs
new file mode 100644
index 0000000..7abeb96
--- /dev/null
+++ b/third_party/gpui/gpui_macos/src/window/gesture_forwarding.rs
@@ -0,0 +1,377 @@
+//! Gives GPUI the trackpad gestures that AppKit sends to its native views.
+//!
+//! AppKit sends a pinch or swipe to the view under the pointer, so one over a
+//! native view never reaches the GPUI view. While any native view is attached,
+//! an event monitor passes GPUI each such gesture as the GPUI view would have
+//! received it, and lets the event go on to the native view unless GPUI handled
+//! it by stopping its propagation.
+
+use super::{
+    MacWindowState,
+    native_views::{hit_test_native_view, native_view_under_press},
+    window_state_of,
+};
+use crate::events::platform_input_from_native;
+use block2::RcBlock;
+use objc2::{msg_send, rc::Retained, runtime::AnyObject};
+use objc2_app_kit::{NSEvent, NSEventMask, NSEventPhase, NSEventType};
+use objc2_foundation::NSPoint;
+use parking_lot::Mutex;
+use std::{
+    cell::{Cell, RefCell},
+    ptr::{self, NonNull},
+    rc::{Rc, Weak},
+    sync::atomic::Ordering,
+};
+
+thread_local! {
+    static MONITOR: RefCell<Weak<GestureMonitor>> = const { RefCell::new(Weak::new()) };
+    static PINCH: Cell<Option<PinchRoute>> = const { Cell::new(None) };
+}
+
+/// The process's gesture monitor, installed while any window has a native view attached.
+pub(super) struct GestureMonitor {
+    monitor: Retained<AnyObject>,
+}
+
+impl GestureMonitor {
+    /// Returns the installed monitor, installing it if no attached view holds it.
+    pub(super) fn acquire() -> Option<Rc<Self>> {
+        if let Some(monitor) = MONITOR.with_borrow(Weak::upgrade) {
+            return Some(monitor);
+        }
+        let handler = RcBlock::new(handle_gesture);
+        let monitor = unsafe {
+            NSEvent::addLocalMonitorForEventsMatchingMask_handler(
+                NSEventMask::Magnify | NSEventMask::Swipe,
+                &handler,
+            )
+        }?;
+        let monitor = Rc::new(Self { monitor });
+        MONITOR.set(Rc::downgrade(&monitor));
+        Some(monitor)
+    }
+}
+
+impl Drop for GestureMonitor {
+    fn drop(&mut self) {
+        PINCH.set(None);
+        unsafe { NSEvent::removeMonitor(&self.monitor) };
+    }
+}
+
+fn handle_gesture(event: NonNull<NSEvent>) -> *mut NSEvent {
+    if unsafe { forward_gesture(event.as_ref()) } {
+        ptr::null_mut()
+    } else {
+        event.as_ptr()
+    }
+}
+
+/// Runs a pinch or swipe through the gesture monitor as AppKit would, returning
+/// the event AppKit goes on to send to the view under the pointer, or null when
+/// GPUI kept it. With no native view attached there's no monitor, so the event
+/// is returned untouched.
+///
+/// # Safety
+///
+/// `event` must be a valid `NSEvent`, and this must be called on the main thread.
+#[doc(hidden)]
+pub unsafe fn monitor_gesture(event: NonNull<AnyObject>) -> *mut AnyObject {
+    let event = event.cast::<NSEvent>();
+    if MONITOR.with_borrow(Weak::strong_count) == 0 {
+        return event.as_ptr().cast();
+    }
+    handle_gesture(event).cast()
+}
+
+/// Where AppKit sends a gesture.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub(super) enum GestureTarget {
+    /// A view GPUI attached to its window, which the GPUI view never hears of.
+    NativeView,
+    /// The GPUI view, or anything else in a GPUI window that GPUI didn't attach.
+    WindowContent,
+    /// A window GPUI neither owns nor is hosted in.
+    OtherWindow,
+}
+
+/// Whether GPUI is passed the pinch under way in a window, and how much of it GPUI
+/// has claimed. AppKit keeps sending a pinch to the view it began over, so the
+/// route is decided as the pinch begins.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub(super) struct PinchRoute {
+    window: usize,
+    forwards: bool,
+    claim: GestureClaim,
+}
+
+impl PinchRoute {
+    /// Records whether GPUI handled an event of the pinch, returning whether the
+    /// native view is kept from it and the route the rest of the pinch keeps.
+    pub(super) fn after(self, phase: NSEventPhase, handled: bool) -> (bool, Option<Self>) {
+        let (claim, consumes) = self.claim.after(phase, handled);
+        (consumes, (!ends(phase)).then_some(Self { claim, ..self }))
+    }
+}
+
+/// How much of a gesture GPUI keeps from the native view it was sent to. AppKit
+/// and the native view only ever hear a gesture that begins and ends.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub(super) enum GestureClaim {
+    /// GPUI hasn't handled the gesture, so the native view hears all of it.
+    Unclaimed,
+    /// GPUI handled the gesture as it began, so the native view hears none of it.
+    FromStart,
+    /// GPUI handled the gesture after the native view heard it begin. The native
+    /// view hears no more of it but its end, which closes the gesture it began.
+    Midway,
+}
+
+impl GestureClaim {
+    /// The claim after GPUI did or didn't handle an event of the gesture, and
+    /// whether the native view is kept from that event.
+    pub(super) fn after(self, phase: NSEventPhase, handled: bool) -> (Self, bool) {
+        let claim = match self {
+            _ if begins(phase) => {
+                if handled {
+                    Self::FromStart
+                } else {
+                    Self::Unclaimed
+                }
+            }
+            Self::Unclaimed if handled => Self::Midway,
+            claim => claim,
+        };
+        let consumes = match claim {
+            Self::Unclaimed => false,
+            Self::FromStart => true,
+            Self::Midway => !ends(phase),
+        };
+        (claim, consumes)
+    }
+}
+
+fn begins(phase: NSEventPhase) -> bool {
+    phase.intersects(NSEventPhase::Began | NSEventPhase::MayBegin)
+}
+
+fn ends(phase: NSEventPhase) -> bool {
+    phase.intersects(NSEventPhase::Ended | NSEventPhase::Cancelled)
+}
+
+/// Whether GPUI should be passed a gesture AppKit sends to `target`.
+pub(super) fn forwards_gesture(target: GestureTarget) -> bool {
+    target == GestureTarget::NativeView
+}
+
+/// The route of a pinch event in `window`: the pinch's own, or a new one as a pinch begins.
+pub(super) fn route_pinch(
+    route: Option<PinchRoute>,
+    window: usize,
+    phase: NSEventPhase,
+    target: impl FnOnce() -> GestureTarget,
+) -> PinchRoute {
+    match route {
+        Some(route) if route.window == window && !begins(phase) => route,
+        _ => PinchRoute {
+            window,
+            forwards: forwards_gesture(target()),
+            claim: GestureClaim::Unclaimed,
+        },
+    }
+}
+
+unsafe fn forward_gesture(event: &NSEvent) -> bool {
+    let window: *mut AnyObject = unsafe { msg_send![event, window] };
+    let window_state = unsafe { window_state_of(window) };
+    let position = event.locationInWindow();
+    let target = || match &window_state {
+        Some(window_state) => unsafe { target_at(window_state, &*window, position) },
+        None => GestureTarget::OtherWindow,
+    };
+    let handled_by_gpui = |forwards: bool| {
+        forwards
+            && window_state
+                .as_ref()
+                .is_some_and(|window_state| pass_gesture_to_gpui(window_state, event))
+    };
+    if event.r#type() == NSEventType::Magnify {
+        let phase = event.phase();
+        let route = route_pinch(PINCH.get(), window as usize, phase, target);
+        let (consumes, route) = route.after(phase, handled_by_gpui(route.forwards));
+        PINCH.set(route);
+        consumes
+    } else {
+        handled_by_gpui(forwards_gesture(target()))
+    }
+}
+
+unsafe fn target_at(
+    window_state: &Rc<Mutex<MacWindowState>>,
+    window: &AnyObject,
+    position_in_window: NSPoint,
+) -> GestureTarget {
+    let under_view = hit_test_native_view(window_state, position_in_window)
+        .and_then(|_| unsafe { native_view_under_press(window_state, window, position_in_window) });
+    if under_view.is_some() {
+        GestureTarget::NativeView
+    } else {
+        GestureTarget::WindowContent
+    }
+}
+
+fn pass_gesture_to_gpui(window_state: &Rc<Mutex<MacWindowState>>, event: &NSEvent) -> bool {
+    let (input, mut callback) = {
+        let Some(mut lock) = window_state.try_lock() else {
+            return false;
+        };
+        let native_event = event as *const NSEvent as *mut AnyObject;
+        let Some(input) =
+            (unsafe { platform_input_from_native(native_event, Some(lock.view_frame())) })
+        else {
+            return false;
+        };
+        let Some(callback) = lock.event_callback.take() else {
+            return false;
+        };
+        lock.cursor_visible.store(true, Ordering::Relaxed);
+        (input, callback)
+    };
+    let handled = !callback(input).propagate;
+    window_state.lock().event_callback = Some(callback);
+    handled
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn only_gestures_sent_to_a_native_view_are_forwarded() {
+        assert!(forwards_gesture(GestureTarget::NativeView));
+        assert!(!forwards_gesture(GestureTarget::WindowContent));
+        assert!(!forwards_gesture(GestureTarget::OtherWindow));
+    }
+
+    #[test]
+    fn a_pinch_keeps_the_route_it_began_with() {
+        let unreachable = || -> GestureTarget { panic!("a pinch under way isn't hit-tested") };
+        let route = route_pinch(None, 1, NSEventPhase::Began, || GestureTarget::NativeView);
+        assert!(route.forwards);
+        let (_, route) = route.after(NSEventPhase::Began, false);
+        let route = route_pinch(route, 1, NSEventPhase::Changed, unreachable);
+        assert!(
+            route.forwards,
+            "a pinch begun over a page goes on reaching GPUI"
+        );
+        let (_, route) = route.after(NSEventPhase::Changed, false);
+        let route = route_pinch(route, 1, NSEventPhase::Ended, unreachable);
+        assert!(route.forwards);
+        let (_, route) = route.after(NSEventPhase::Ended, false);
+        assert_eq!(route, None, "the route ends with the pinch");
+
+        let route = route_pinch(None, 1, NSEventPhase::Began, || {
+            GestureTarget::WindowContent
+        });
+        assert!(!route.forwards);
+        let (_, route) = route.after(NSEventPhase::Began, false);
+        let route = route_pinch(route, 1, NSEventPhase::Changed, unreachable);
+        assert!(
+            !route.forwards,
+            "a pinch begun over the GPUI view stays its own"
+        );
+    }
+
+    #[test]
+    fn a_pinch_in_another_window_or_a_new_pinch_is_routed_again() {
+        let over_page = Some(PinchRoute {
+            window: 1,
+            forwards: true,
+            claim: GestureClaim::FromStart,
+        });
+        let route = route_pinch(over_page, 2, NSEventPhase::Changed, || {
+            GestureTarget::OtherWindow
+        });
+        assert_eq!(
+            route,
+            PinchRoute {
+                window: 2,
+                forwards: false,
+                claim: GestureClaim::Unclaimed,
+            }
+        );
+        let route = route_pinch(over_page, 1, NSEventPhase::Began, || {
+            GestureTarget::WindowContent
+        });
+        assert!(!route.forwards);
+        assert_eq!(route.claim, GestureClaim::Unclaimed);
+    }
+
+    const PINCH: [NSEventPhase; 4] = [
+        NSEventPhase::Began,
+        NSEventPhase::Changed,
+        NSEventPhase::Changed,
+        NSEventPhase::Ended,
+    ];
+
+    fn consumed(handled: [bool; 4]) -> Vec<bool> {
+        let mut route = None;
+        let consumed = PINCH
+            .iter()
+            .zip(handled)
+            .map(|(&phase, handled)| {
+                let (consumes, next) = route_pinch(route, 1, phase, || {
+                    assert!(route.is_none(), "a pinch under way isn't hit-tested");
+                    GestureTarget::NativeView
+                })
+                .after(phase, handled);
+                route = next;
+                consumes
+            })
+            .collect();
+        assert_eq!(route, None);
+        consumed
+    }
+
+    #[test]
+    fn a_pinch_gpui_handles_as_it_begins_is_kept_from_the_native_view() {
+        assert_eq!(consumed([true, true, true, true]), [true; 4]);
+        assert_eq!(
+            consumed([true, false, false, false]),
+            [true; 4],
+            "the native view never hears the rest of a pinch it never heard begin"
+        );
+    }
+
+    #[test]
+    fn a_pinch_gpui_leaves_reaches_the_native_view() {
+        assert_eq!(consumed([false; 4]), [false; 4]);
+    }
+
+    #[test]
+    fn a_pinch_gpui_handles_midway_is_kept_from_the_native_view_until_it_ends() {
+        assert_eq!(
+            consumed([false, true, false, false]),
+            [false, true, true, false],
+            "the native view hears the pinch begin and end, and none of it in between"
+        );
+        assert_eq!(consumed([false, false, false, true]), [false; 4]);
+    }
+
+    #[test]
+    fn a_cancelled_or_new_gesture_settles_its_claim() {
+        assert_eq!(
+            GestureClaim::Midway.after(NSEventPhase::Cancelled, false),
+            (GestureClaim::Midway, false)
+        );
+        assert_eq!(
+            GestureClaim::FromStart.after(NSEventPhase::Cancelled, false),
+            (GestureClaim::FromStart, true)
+        );
+        assert_eq!(
+            GestureClaim::FromStart.after(NSEventPhase::MayBegin, false),
+            (GestureClaim::Unclaimed, false)
+        );
+    }
+}
diff --git a/third_party/gpui/gpui_macos/src/window/gesture_present.rs b/third_party/gpui/gpui_macos/src/window/gesture_present.rs
new file mode 100644
index 0000000..66a124c
--- /dev/null
+++ b/third_party/gpui/gpui_macos/src/window/gesture_present.rs
@@ -0,0 +1,154 @@
+//! Presents a window synchronously while a trackpad gesture moves it.
+//!
+//! A `CAMetalDisplayLink` frame reaches the display several refreshes after
+//! the link asks for it. While a scroll or pinch gesture is moving the window,
+//! the window instead draws right after each event that dirties it and
+//! presents with the Core Animation transaction, so its native views move in
+//! the same transaction as its GPUI content. The display link comes back once
+//! the gesture and its momentum end. `ARDIA_GPUI_GESTURE_PRESENT=0` turns this
+//! off.
+
+use super::{FrameSource, MacWindowState, frame_drawable, native_views};
+use crate::{GesturePhase, GestureTransition, MetalFrames};
+use gpui::{FrameRequestSource, PlatformFrameSignal, RequestFrameOptions};
+use objc2::{Message, msg_send, runtime::AnyObject};
+use objc2_app_kit::{NSEventPhase, NSEventType};
+use parking_lot::Mutex;
+use std::rc::Rc;
+
+pub(super) fn gesture_phase(native_event: *mut AnyObject) -> Option<GesturePhase> {
+    let event_type: NSEventType = unsafe { msg_send![native_event, type] };
+    let momentum = match event_type {
+        NSEventType::ScrollWheel => {
+            let momentum: NSEventPhase = unsafe { msg_send![native_event, momentumPhase] };
+            momentum
+        }
+        NSEventType::Magnify => NSEventPhase::None,
+        _ => return None,
+    };
+    let phase: NSEventPhase = unsafe { msg_send![native_event, phase] };
+    Some(GesturePhase::from_bits(phase.0 as u64, momentum.0 as u64))
+}
+
+fn metal_frames(state: &MacWindowState) -> Option<Rc<MetalFrames>> {
+    match &state.frame_source {
+        FrameSource::Metal(metal_frames) => Some(metal_frames.clone()),
+        FrameSource::DisplayLink(_) => None,
+    }
+}
+
+pub(super) fn before_dispatch(state: &MacWindowState) {
+    if let Some(metal_frames) = metal_frames(state) {
+        metal_frames.begin_gesture_dispatch();
+    }
+}
+
+pub(super) fn after_dispatch(window_state: &Rc<Mutex<MacWindowState>>, phase: GesturePhase) {
+    let Some(metal_frames) = metal_frames(&window_state.lock()) else {
+        return;
+    };
+    if metal_frames.gesture_after_event(phase) == GestureTransition::Enter {
+        let mut lock = window_state.lock();
+        lock.stop_display_link();
+        let refresh_interval = refresh_interval(&lock);
+        metal_frames.enter_gesture_mode(&mut lock.renderer, refresh_interval);
+    }
+    present_if_due(window_state, &metal_frames);
+}
+
+fn present_if_due(window_state: &Rc<Mutex<MacWindowState>>, metal_frames: &Rc<MetalFrames>) {
+    if !metal_frames.is_in_gesture_mode() {
+        return;
+    }
+    if metal_frames.gesture_frame_due() {
+        draw(window_state, metal_frames);
+    }
+    schedule_tick(window_state, metal_frames);
+}
+
+fn refresh_interval(state: &MacWindowState) -> f64 {
+    let screen: *mut AnyObject = unsafe { msg_send![state.native_window, screen] };
+    if screen.is_null() {
+        return 0.0;
+    }
+    unsafe { msg_send![screen, minimumRefreshInterval] }
+}
+
+fn draw(window_state: &Rc<Mutex<MacWindowState>>, metal_frames: &MetalFrames) {
+    let signal_at = PlatformFrameSignal::capture(scheduler::Instant::now);
+    let drawable = frame_drawable::with_unlocked(
+        window_state,
+        |state| {
+            state.request_frame_callback.as_ref()?;
+            state.renderer.layer().map(|layer| layer.retain())
+        },
+        |layer| layer.nextDrawable(),
+    );
+    let Some(Some(drawable)) = drawable else {
+        return;
+    };
+    let mut lock = window_state.lock();
+    let Some(mut callback) = lock.request_frame_callback.take() else {
+        return;
+    };
+    if metal_frames.is_attached() {
+        lock.request_frame_callback = Some(callback);
+        return;
+    }
+    metal_frames.begin_gesture_frame(&drawable);
+    lock.renderer.set_display_link_attached(true);
+    lock.renderer.set_frame_drawable(Some(drawable));
+    drop(lock);
+    frame_drawable::in_transaction(|| {
+        callback(RequestFrameOptions {
+            signal_at,
+            signal_source: FrameRequestSource::NativeCallback,
+            ..Default::default()
+        })
+    });
+    let mut lock = window_state.lock();
+    lock.request_frame_callback = Some(callback);
+    let used_drawable = if metal_frames.is_attached() {
+        true
+    } else {
+        let used_drawable = lock.renderer.set_frame_drawable(None).is_none();
+        lock.renderer.set_display_link_attached(false);
+        used_drawable
+    };
+    drop(lock);
+    metal_frames.end_gesture_frame(used_drawable);
+    native_views::check_pointer_after_frame(window_state);
+}
+
+fn schedule_tick(window_state: &Rc<Mutex<MacWindowState>>, metal_frames: &MetalFrames) {
+    let Some(delay) = metal_frames.schedule_gesture_tick() else {
+        return;
+    };
+    let lock = window_state.lock();
+    let foreground_executor = lock.foreground_executor.clone();
+    let background_executor = lock.background_executor.clone();
+    drop(lock);
+    let window_state = Rc::downgrade(window_state);
+    foreground_executor
+        .spawn(async move {
+            background_executor.timer(delay).await;
+            if let Some(window_state) = window_state.upgrade() {
+                tick(&window_state);
+            }
+        })
+        .detach();
+}
+
+fn tick(window_state: &Rc<Mutex<MacWindowState>>) {
+    let Some(metal_frames) = metal_frames(&window_state.lock()) else {
+        return;
+    };
+    metal_frames.gesture_tick_fired();
+    if metal_frames.gesture_tick() == GestureTransition::Exit {
+        let mut lock = window_state.lock();
+        metal_frames.exit_gesture_mode(&mut lock.renderer);
+        lock.start_display_link(window_state);
+        return;
+    }
+    present_if_due(window_state, &metal_frames);
+}
diff --git a/third_party/gpui/gpui_macos/src/window/hosted.rs b/third_party/gpui/gpui_macos/src/window/hosted.rs
new file mode 100644
index 0000000..1efd6d3
--- /dev/null
+++ b/third_party/gpui/gpui_macos/src/window/hosted.rs
@@ -0,0 +1,320 @@
+use super::{
+    MacWindowState, WINDOW_STATE_IVAR, drop_window_state,
+    native_views::{
+        route_key_down, route_make_first_responder, route_perform_key_equivalent, route_send_event,
+    },
+    window_did_change_key_status, window_did_change_occlusion_state, window_did_change_screen,
+    window_did_move, window_did_resize, window_state_if_set,
+};
+use crate::ns_string;
+use objc2::{
+    class, msg_send,
+    rc::Retained,
+    runtime::{AnyClass, AnyObject, Bool, ClassBuilder, Sel},
+    sel,
+};
+use objc2_app_kit::{NSColor, NSView, NSWindow};
+use parking_lot::Mutex;
+use std::{
+    cell::RefCell,
+    ffi::c_void,
+    ptr::{self, NonNull},
+    rc::{Rc, Weak},
+    sync::{OnceLock, atomic::Ordering},
+};
+
+fn notifications() -> [(&'static str, Sel); 7] {
+    [
+        ("NSWindowDidResizeNotification", sel!(windowDidResize:)),
+        ("NSWindowDidMoveNotification", sel!(windowDidMove:)),
+        (
+            "NSWindowDidChangeScreenNotification",
+            sel!(windowDidChangeScreen:),
+        ),
+        (
+            "NSWindowDidBecomeKeyNotification",
+            sel!(windowDidBecomeKey:),
+        ),
+        (
+            "NSWindowDidResignKeyNotification",
+            sel!(windowDidResignKey:),
+        ),
+        (
+            "NSWindowDidChangeOcclusionStateNotification",
+            sel!(windowDidChangeOcclusionState:),
+        ),
+        ("NSWindowWillCloseNotification", sel!(windowWillClose:)),
+    ]
+}
+
+thread_local! {
+    static HOSTED_WINDOWS: RefCell<Vec<(usize, Weak<Mutex<MacWindowState>>)>> = const { RefCell::new(Vec::new()) };
+}
+
+fn observer_class() -> &'static AnyClass {
+    static CLASS: OnceLock<&'static AnyClass> = OnceLock::new();
+    CLASS.get_or_init(|| {
+        let name = c"GPUIHostedWindowObserver";
+        let Some(mut builder) = ClassBuilder::new(name, class!(NSObject)) else {
+            return AnyClass::get(name).unwrap_or(class!(NSObject));
+        };
+        builder.add_ivar::<*mut c_void>(WINDOW_STATE_IVAR);
+        unsafe {
+            builder.add_method(
+                sel!(windowDidResize:),
+                window_did_resize as extern "C" fn(_, Sel, *mut AnyObject),
+            );
+            builder.add_method(
+                sel!(windowDidMove:),
+                window_did_move as extern "C" fn(_, Sel, *mut AnyObject),
+            );
+            builder.add_method(
+                sel!(windowDidChangeScreen:),
+                window_did_change_screen as extern "C" fn(_, Sel, *mut AnyObject),
+            );
+            builder.add_method(
+                sel!(windowDidBecomeKey:),
+                window_did_change_key_status as extern "C" fn(_, Sel, *mut AnyObject),
+            );
+            builder.add_method(
+                sel!(windowDidResignKey:),
+                window_did_change_key_status as extern "C" fn(_, Sel, *mut AnyObject),
+            );
+            builder.add_method(
+                sel!(windowDidChangeOcclusionState:),
+                window_did_change_occlusion_state as extern "C" fn(_, Sel, *mut AnyObject),
+            );
+            builder.add_method(
+                sel!(windowWillClose:),
+                window_will_close as extern "C" fn(_, Sel, *mut AnyObject),
+            );
+            builder.add_method(sel!(dealloc), dealloc_observer as extern "C" fn(_, Sel));
+        }
+        builder.register()
+    })
+}
+
+pub(super) struct Host {
+    window: Retained<NSWindow>,
+    state: Weak<Mutex<MacWindowState>>,
+    view: Option<Retained<NSView>>,
+    observer: Option<Retained<AnyObject>>,
+    chrome: Option<Chrome>,
+}
+
+struct Chrome {
+    opaque: bool,
+    background: Retained<NSColor>,
+}
+
+pub(super) struct Detached {
+    window: Retained<NSWindow>,
+    view: Option<Retained<NSView>>,
+    chrome: Option<Chrome>,
+}
+
+impl Host {
+    pub(super) unsafe fn attach(
+        window_state: &Rc<Mutex<MacWindowState>>,
+        window: *mut AnyObject,
+        view: *mut AnyObject,
+    ) -> Self {
+        let window = unsafe { Retained::retain(window.cast::<NSWindow>()) }
+            .expect("a hosted GPUI window needs its host NSWindow");
+        let view = unsafe { Retained::retain(view.cast::<NSView>()) }
+            .expect("a hosted GPUI window needs its GPUI view");
+        let observer: Retained<AnyObject> = unsafe { msg_send![observer_class(), new] };
+        unsafe {
+            observer
+                .class()
+                .instance_variable(WINDOW_STATE_IVAR)
+                .expect("hosted window observer state ivar")
+                .load_ptr::<*mut c_void>(&observer)
+                .write(Rc::into_raw(window_state.clone()).cast_mut().cast());
+            let center: *mut AnyObject = msg_send![class!(NSNotificationCenter), defaultCenter];
+            for (name, selector) in notifications() {
+                let _: () = msg_send![
+                    center,
+                    addObserver: &*observer,
+                    selector: selector,
+                    name: ns_string(name),
+                    object: &*window
+                ];
+            }
+        }
+        let address = Retained::as_ptr(&window) as usize;
+        HOSTED_WINDOWS.with_borrow_mut(|windows| {
+            windows.retain(|(_, state)| state.strong_count() > 0);
+            windows.push((address, Rc::downgrade(window_state)));
+        });
+        Self {
+            window,
+            state: Rc::downgrade(window_state),
+            view: Some(view),
+            observer: Some(observer),
+            chrome: None,
+        }
+    }
+
+    pub(super) fn save_chrome(&mut self) {
+        if self.chrome.is_none() && self.observer.is_some() {
+            self.chrome = Some(Chrome {
+                opaque: self.window.isOpaque(),
+                background: self.window.backgroundColor(),
+            });
+        }
+    }
+
+    pub(super) fn detach(&mut self) -> Option<Detached> {
+        let observer = self.observer.take()?;
+        unsafe {
+            let center: *mut AnyObject = msg_send![class!(NSNotificationCenter), defaultCenter];
+            let _: () = msg_send![center, removeObserver: &*observer];
+            drop_window_state(&observer);
+        }
+        let _ = HOSTED_WINDOWS.try_with(|windows| {
+            windows
+                .borrow_mut()
+                .retain(|(_, state)| !state.ptr_eq(&self.state) && state.strong_count() > 0)
+        });
+        Some(Detached {
+            window: self.window.clone(),
+            view: self.view.take(),
+            chrome: self.chrome.take(),
+        })
+    }
+}
+
+impl Detached {
+    pub(super) fn restore_chrome(&mut self) {
+        if let Some(chrome) = self.chrome.take() {
+            self.window.setOpaque(chrome.opaque);
+            self.window.setBackgroundColor(Some(&chrome.background));
+        }
+    }
+
+    pub(super) fn finish(
+        self,
+        views: impl IntoIterator<Item = Retained<NSView>>,
+        host_closed: bool,
+    ) {
+        let views = self.view.into_iter().chain(views).collect::<Vec<_>>();
+        if !host_closed {
+            unsafe {
+                let responder: *mut AnyObject = msg_send![&*self.window, firstResponder];
+                let is_view: bool =
+                    !responder.is_null() && msg_send![responder, isKindOfClass: class!(NSView)];
+                if is_view
+                    && views
+                        .iter()
+                        .any(|view| msg_send![responder, isDescendantOf: &**view])
+                {
+                    let _: Bool = msg_send![
+                        &*self.window,
+                        makeFirstResponder: ptr::null_mut::<AnyObject>()
+                    ];
+                }
+            }
+        }
+        for view in views.iter().rev() {
+            view.removeFromSuperview();
+        }
+    }
+}
+
+pub(super) fn window_state(native_window: *mut AnyObject) -> Option<Rc<Mutex<MacWindowState>>> {
+    HOSTED_WINDOWS.with_borrow(|windows| {
+        windows
+            .iter()
+            .find(|(window, _)| *window == native_window as usize)
+            .and_then(|(_, state)| state.upgrade())
+    })
+}
+
+extern "C" fn window_will_close(this: &AnyObject, _: Sel, _: *mut AnyObject) {
+    let Some(window_state) = (unsafe { window_state_if_set(this) }) else {
+        return;
+    };
+    let close_callback = {
+        let mut lock = window_state.lock();
+        lock.closed.store(true, Ordering::Release);
+        lock.close_callback.take()
+    };
+    if let Some(callback) = close_callback {
+        callback();
+    }
+}
+
+extern "C" fn dealloc_observer(this: &AnyObject, _: Sel) {
+    unsafe {
+        drop_window_state(this);
+        let _: () = msg_send![super(this, class!(NSObject)), dealloc];
+    }
+}
+
+#[allow(clippy::missing_safety_doc)]
+pub unsafe fn send_event(
+    window: NonNull<c_void>,
+    event: NonNull<c_void>,
+    call_super: impl FnOnce(),
+) {
+    let window = window.cast::<AnyObject>();
+    unsafe {
+        route_send_event(
+            window.as_ref(),
+            window_state(window.as_ptr()),
+            event.as_ptr().cast(),
+            call_super,
+        )
+    }
+}
+
+#[allow(clippy::missing_safety_doc)]
+pub unsafe fn make_first_responder(
+    window: NonNull<c_void>,
+    responder: Option<NonNull<c_void>>,
+    call_super: impl FnOnce() -> bool,
+) -> bool {
+    let window = window.cast::<AnyObject>();
+    let responder = responder.map_or(ptr::null_mut(), |responder| responder.as_ptr().cast());
+    unsafe {
+        route_make_first_responder(
+            window.as_ref(),
+            window_state(window.as_ptr()),
+            responder,
+            || Bool::new(call_super()),
+        )
+    }
+    .as_bool()
+}
+
+#[allow(clippy::missing_safety_doc)]
+pub unsafe fn perform_key_equivalent(
+    window: NonNull<c_void>,
+    event: NonNull<c_void>,
+    call_super: impl FnOnce() -> bool,
+) -> bool {
+    let window = window.cast::<AnyObject>();
+    unsafe {
+        route_perform_key_equivalent(
+            window.as_ref(),
+            window_state(window.as_ptr()),
+            event.as_ptr().cast(),
+            || Bool::new(call_super()),
+        )
+    }
+    .as_bool()
+}
+
+#[allow(clippy::missing_safety_doc)]
+pub unsafe fn key_down(window: NonNull<c_void>, event: NonNull<c_void>, call_super: impl FnOnce()) {
+    let window = window.cast::<AnyObject>();
+    unsafe {
+        route_key_down(
+            window.as_ref(),
+            window_state(window.as_ptr()),
+            event.as_ptr().cast(),
+            call_super,
+        )
+    }
+}
diff --git a/third_party/gpui/gpui_macos/src/window/key_appearance.rs b/third_party/gpui/gpui_macos/src/window/key_appearance.rs
new file mode 100644
index 0000000..9fd718c
--- /dev/null
+++ b/third_party/gpui/gpui_macos/src/window/key_appearance.rs
@@ -0,0 +1,177 @@
+use block2::RcBlock;
+use objc2::{
+    MainThreadMarker, class, ffi, msg_send,
+    runtime::{AnyClass, AnyObject, Bool, ClassBuilder, Imp, Sel},
+    sel,
+};
+use objc2_app_kit::{NSView, NSWindow, NSWindowButton};
+use parking_lot::Mutex;
+use std::{collections::HashSet, mem};
+
+static KEEPERS: Mutex<Option<HashSet<usize>>> = Mutex::new(None);
+static HOSTED_CLASSES: Mutex<Option<HashSet<usize>>> = Mutex::new(None);
+
+type HasKeyAppearance = unsafe extern "C-unwind" fn(&AnyObject, Sel) -> Bool;
+
+fn address(window: &AnyObject) -> usize {
+    window as *const AnyObject as usize
+}
+
+fn keeps(window: usize) -> bool {
+    KEEPERS
+        .lock()
+        .as_ref()
+        .is_some_and(|keepers| keepers.contains(&window))
+}
+
+pub(super) fn forces(window: &NSWindow) -> bool {
+    let object: &AnyObject = window.as_ref();
+    MainThreadMarker::new().is_some() && keeps(address(object))
+}
+
+pub(super) fn set_keeps(window: &NSWindow, keeps: bool) {
+    let object: &AnyObject = window.as_ref();
+    let window_address = address(object);
+    {
+        let mut keepers = KEEPERS.lock();
+        let keepers = keepers.get_or_insert_with(HashSet::new);
+        if keeps {
+            keepers.insert(window_address);
+        } else {
+            keepers.remove(&window_address);
+        }
+    }
+    refresh(window);
+}
+
+pub(super) fn forget(window: &NSWindow) {
+    let object: &AnyObject = window.as_ref();
+    let window_address = address(object);
+    if let Some(keepers) = KEEPERS.lock().as_mut() {
+        keepers.remove(&window_address);
+    }
+}
+
+fn refresh(window: &NSWindow) {
+    for button in [
+        NSWindowButton::CloseButton,
+        NSWindowButton::MiniaturizeButton,
+        NSWindowButton::ZoomButton,
+    ] {
+        if let Some(button) = window.standardWindowButton(button) {
+            let view: &NSView = &button;
+            view.setNeedsDisplay(true);
+        }
+    }
+    if let Some(frame) = window
+        .contentView()
+        .and_then(|view| unsafe { view.superview() })
+    {
+        frame.setNeedsDisplay(true);
+    }
+}
+
+pub(super) unsafe fn add_window_methods(decl: &mut ClassBuilder, superclass: &AnyClass) {
+    unsafe {
+        if superclass == class!(NSPanel) {
+            decl.add_method(
+                sel!(hasKeyAppearance),
+                panel_has_key_appearance as extern "C" fn(_, Sel) -> Bool,
+            );
+        } else {
+            decl.add_method(
+                sel!(hasKeyAppearance),
+                window_has_key_appearance as extern "C" fn(_, Sel) -> Bool,
+            );
+        }
+    }
+}
+
+fn as_window(object: &AnyObject) -> &NSWindow {
+    unsafe { &*(object as *const AnyObject).cast::<NSWindow>() }
+}
+
+extern "C" fn window_has_key_appearance(this: &AnyObject, _: Sel) -> Bool {
+    if forces(as_window(this)) {
+        return Bool::YES;
+    }
+    unsafe { msg_send![super(this, class!(NSWindow)), hasKeyAppearance] }
+}
+
+extern "C" fn panel_has_key_appearance(this: &AnyObject, _: Sel) -> Bool {
+    if forces(as_window(this)) {
+        return Bool::YES;
+    }
+    unsafe { msg_send![super(this, class!(NSPanel)), hasKeyAppearance] }
+}
+
+pub(super) fn patch_hosted_class(window: &NSWindow) -> bool {
+    let selector = sel!(hasKeyAppearance);
+    let class: &'static AnyClass = unsafe { msg_send![window, class] };
+    let mut patched = HOSTED_CLASSES.lock();
+    let patched = patched.get_or_insert_with(HashSet::new);
+    if patched.contains(&class_key(class)) {
+        return true;
+    }
+    let Some(method) = class.instance_method(selector) else {
+        return false;
+    };
+    let superclass = class.superclass();
+    let inherited = superclass
+        .and_then(|superclass| superclass.instance_method(selector))
+        .is_some_and(|above| std::ptr::eq(above, method));
+    let next = if inherited {
+        let Some(superclass) = superclass else {
+            return false;
+        };
+        NextAppearance::Superclass(superclass)
+    } else {
+        NextAppearance::Own(method.implementation())
+    };
+    let ours = hosted_imp(next);
+    if inherited {
+        let types = unsafe { ffi::method_getTypeEncoding(method) };
+        let class = class as *const AnyClass as *mut AnyClass;
+        if !unsafe { ffi::class_addMethod(class, selector, ours, types) }.as_bool() {
+            return false;
+        }
+    } else {
+        unsafe { method.set_implementation(ours) };
+    }
+    patched.insert(class_key(class));
+    true
+}
+
+fn class_key(class: &AnyClass) -> usize {
+    class as *const AnyClass as usize
+}
+
+#[derive(Clone, Copy)]
+enum NextAppearance {
+    Own(Imp),
+    Superclass(&'static AnyClass),
+}
+
+fn hosted_imp(next: NextAppearance) -> Imp {
+    let block = RcBlock::new(move |this: *mut AnyObject| -> Bool {
+        let Some(this) = (unsafe { this.as_ref() }) else {
+            return Bool::NO;
+        };
+        hosted_has_key_appearance(this, next)
+    });
+    unsafe { ffi::imp_implementationWithBlock(RcBlock::as_ptr(&block).cast()) }
+}
+
+fn hosted_has_key_appearance(this: &AnyObject, next: NextAppearance) -> Bool {
+    if forces(as_window(this)) {
+        return Bool::YES;
+    }
+    match next {
+        NextAppearance::Own(original) => unsafe {
+            mem::transmute::<Imp, HasKeyAppearance>(original)(this, sel!(hasKeyAppearance))
+        },
+        NextAppearance::Superclass(superclass) => unsafe {
+            msg_send![super(this, superclass), hasKeyAppearance]
+        },
+    }
+}
diff --git a/third_party/gpui/gpui_macos/src/window/liquid_glass.rs b/third_party/gpui/gpui_macos/src/window/liquid_glass.rs
new file mode 100644
index 0000000..d8d2974
--- /dev/null
+++ b/third_party/gpui/gpui_macos/src/window/liquid_glass.rs
@@ -0,0 +1,1583 @@
+use super::is_macos_version_at_least;
+use gpui::{
+    BackdropAppearance, Bounds, DrawOrder, LiquidGlassRegion, LiquidGlassStyle, Rgba, ScaledPixels,
+};
+use objc2::{
+    class, msg_send,
+    rc::Retained,
+    runtime::{AnyClass, AnyObject, Bool, ClassBuilder, Sel},
+    sel,
+};
+use objc2_app_kit::{
+    NSAppearance, NSAppearanceCustomization, NSAppearanceNameAqua, NSAppearanceNameDarkAqua,
+    NSColor, NSView, NSVisualEffectBlendingMode, NSVisualEffectMaterial, NSVisualEffectState,
+    NSVisualEffectView, NSWindowOrderingMode,
+};
+use objc2_core_graphics::CGColor;
+use objc2_foundation::{
+    NSComparisonResult, NSOperatingSystemVersion, NSPoint, NSRect, NSSize, NSString,
+};
+use std::{
+    cmp::Ordering,
+    ffi::{CStr, c_void},
+    ptr::{self, NonNull},
+    sync::OnceLock,
+};
+
+const SPARE_VIEWS: usize = 8;
+const SPARE_IDLE_SYNCS: u32 = 600;
+
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub(super) struct GroupKey {
+    id: u64,
+    alpha: u32,
+    clip: [f64; 4],
+    run: u32,
+}
+
+pub(super) fn liquid_glass_available() -> bool {
+    static AVAILABLE: OnceLock<bool> = OnceLock::new();
+    *AVAILABLE.get_or_init(|| {
+        is_macos_version_at_least(NSOperatingSystemVersion {
+            majorVersion: 26,
+            minorVersion: 0,
+            patchVersion: 0,
+        }) && AnyClass::get(c"NSGlassEffectView").is_some()
+    })
+}
+
+fn glass_groups_available() -> bool {
+    static AVAILABLE: OnceLock<bool> = OnceLock::new();
+    *AVAILABLE.get_or_init(|| {
+        liquid_glass_available()
+            && AnyClass::get(c"NSGlassEffectContainerView")
+                .is_some_and(|class| class.instance_method(sel!(setContentView:)).is_some())
+    })
+}
+
+pub(super) fn transparent_class(
+    name: &'static CStr,
+    superclass: &'static AnyClass,
+) -> &'static AnyClass {
+    let Some(mut builder) = ClassBuilder::new(name, superclass) else {
+        return AnyClass::get(name).unwrap_or(superclass);
+    };
+    unsafe {
+        builder.add_method(
+            sel!(hitTest:),
+            ignore_hit_test as extern "C" fn(_, Sel, NSPoint) -> *mut AnyObject,
+        );
+    }
+    builder.register()
+}
+
+extern "C" fn ignore_hit_test(_: &AnyObject, _: Sel, _: NSPoint) -> *mut AnyObject {
+    ptr::null_mut()
+}
+
+fn glass_class() -> &'static AnyClass {
+    static CLASS: OnceLock<&'static AnyClass> = OnceLock::new();
+    CLASS.get_or_init(|| match AnyClass::get(c"NSGlassEffectView") {
+        Some(glass) if liquid_glass_available() => transparent_class(c"GPUILiquidGlassView", glass),
+        _ => transparent_class(c"GPUILiquidGlassVibrancyView", class!(NSVisualEffectView)),
+    })
+}
+
+fn group_class() -> Option<&'static AnyClass> {
+    static CLASS: OnceLock<Option<&'static AnyClass>> = OnceLock::new();
+    *CLASS.get_or_init(|| {
+        glass_groups_available()
+            .then(|| AnyClass::get(c"NSGlassEffectContainerView"))
+            .flatten()
+            .map(|container| transparent_class(c"GPUILiquidGlassGroupView", container))
+    })
+}
+
+fn slot_class() -> &'static AnyClass {
+    static CLASS: OnceLock<&'static AnyClass> = OnceLock::new();
+    CLASS.get_or_init(|| transparent_class(c"GPUILiquidGlassSlotView", class!(NSView)))
+}
+
+pub(super) trait PoolOps<V, P> {
+    fn create(&mut self) -> V;
+    fn apply(&mut self, view: &V, placement: &P, previous: Option<&P>);
+    fn show(&mut self, view: &V);
+    fn hide(&mut self, view: &V);
+    fn discard(&mut self, view: V);
+}
+
+struct PoolEntry<V, K, P> {
+    view: V,
+    key: Option<K>,
+    applied: Option<P>,
+    shown: bool,
+    idle_syncs: u32,
+}
+
+pub(super) struct Pool<V, K, P> {
+    entries: Vec<PoolEntry<V, K, P>>,
+}
+
+impl<V, K, P> Default for Pool<V, K, P> {
+    fn default() -> Self {
+        Self {
+            entries: Vec::new(),
+        }
+    }
+}
+
+impl<V: Clone, K: Copy + PartialEq, P: Clone + PartialEq> Pool<V, K, P> {
+    pub(super) fn sync(&mut self, wanted: &[(K, P)], ops: &mut impl PoolOps<V, P>) -> Vec<V> {
+        let mut used = vec![false; self.entries.len()];
+        let mut slots = Vec::with_capacity(wanted.len());
+        for (key, _) in wanted {
+            let unused_with_key =
+                |index: &usize| !used[*index] && self.entries[*index].key.as_ref() == Some(key);
+            let bound = (0..self.entries.len())
+                .filter(unused_with_key)
+                .find(|&index| self.entries[index].shown)
+                .or_else(|| (0..self.entries.len()).find(unused_with_key));
+            if let Some(index) = bound {
+                used[index] = true;
+            }
+            slots.push(bound);
+        }
+        for (slot, (_, placement)) in slots.iter_mut().zip(wanted) {
+            if slot.is_some() {
+                continue;
+            }
+            let unused = |index: &usize| !used[*index];
+            let index = (0..self.entries.len())
+                .filter(unused)
+                .find(|&index| self.entries[index].applied.as_ref() == Some(placement))
+                .or_else(|| (0..self.entries.len()).find(unused))
+                .unwrap_or_else(|| {
+                    self.entries.push(PoolEntry {
+                        view: ops.create(),
+                        key: None,
+                        applied: None,
+                        shown: false,
+                        idle_syncs: 0,
+                    });
+                    used.push(false);
+                    self.entries.len() - 1
+                });
+            used[index] = true;
+            *slot = Some(index);
+        }
+        for (entry, used) in self.entries.iter_mut().zip(&used) {
+            if *used {
+                continue;
+            }
+            if entry.shown {
+                entry.shown = false;
+                entry.idle_syncs = 0;
+                ops.hide(&entry.view);
+            } else {
+                entry.idle_syncs = entry.idle_syncs.saturating_add(1);
+            }
+        }
+        let mut views = Vec::with_capacity(wanted.len());
+        for ((key, placement), index) in wanted.iter().zip(slots.into_iter().flatten()) {
+            let entry = &mut self.entries[index];
+            if entry.applied.as_ref() != Some(placement) {
+                ops.apply(&entry.view, placement, entry.applied.as_ref());
+                entry.applied = Some(placement.clone());
+            }
+            if !entry.shown {
+                ops.show(&entry.view);
+                entry.shown = true;
+            }
+            entry.key = Some(*key);
+            entry.idle_syncs = 0;
+            views.push(entry.view.clone());
+        }
+        let mut spares = 0;
+        let mut index = 0;
+        while index < self.entries.len() {
+            let entry = &self.entries[index];
+            if !entry.shown {
+                if spares >= SPARE_VIEWS || entry.idle_syncs >= SPARE_IDLE_SYNCS {
+                    ops.discard(self.entries.remove(index).view);
+                    continue;
+                }
+                spares += 1;
+            }
+            index += 1;
+        }
+        views
+    }
+
+    pub(super) fn views(&self) -> impl Iterator<Item = &V> {
+        self.entries.iter().map(|entry| &entry.view)
+    }
+
+    pub(super) fn is_idle(&self) -> bool {
+        self.entries.iter().all(|entry| !entry.shown)
+    }
+}
+
+fn is_finite(region: &LiquidGlassRegion) -> bool {
+    let bounds = region.bounds;
+    [
+        bounds.origin.x,
+        bounds.origin.y,
+        bounds.size.width,
+        bounds.size.height,
+        region.corner_radius,
+    ]
+    .iter()
+    .all(|value| value.0.is_finite())
+}
+
+fn native_alpha(region: &LiquidGlassRegion) -> f32 {
+    if region.alpha.is_finite() {
+        region.alpha.clamp(0., 1.)
+    } else {
+        1.
+    }
+}
