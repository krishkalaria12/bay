+        let mut pool = Pool::<u32, u64, &'static str>::default();
+        let mut ops = Recorder::default();
+        assert_eq!(pool.sync(&[(1, "a"), (2, "b")], &mut ops), [1, 2]);
+        assert_eq!(
+            take_log(&ops),
+            [
+                "create 1",
+                "create 2",
+                "apply 1 a from None",
+                "show 1",
+                "apply 2 b from None",
+                "show 2"
+            ]
+        );
