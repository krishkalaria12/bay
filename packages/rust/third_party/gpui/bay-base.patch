+            .convertPoint_fromView(position_in_window, None);
+        let [x, y, width, height] = placement.view;
+        rounded_rect_contains(
+            [width, height],
+            self.corner_radii,
+            [point.x - x, point.y - y],
+        )
+    }
+}
