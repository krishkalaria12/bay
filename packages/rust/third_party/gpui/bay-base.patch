+        scene.finish();
+        window.draw(&scene);
+        let alpha: f64 = unsafe { msg_send![container, alphaValue] };
+        let bounds: Rect = unsafe { msg_send![container, bounds] };
+        let frame: Rect = unsafe { msg_send![container, frame] };
