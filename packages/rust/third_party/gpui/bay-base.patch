+        assert_eq!(pool.sync(&[(2, "b"), (1, "a")], &mut ops), [2, 1]);
+        assert_eq!(take_log(&ops), [] as [String; 0]);
+
+        assert_eq!(pool.sync(&[(1, "moved")], &mut ops), [1]);
+        assert_eq!(take_log(&ops), ["hide 2", "apply 1 moved from Some(\"a\")"]);
+    }
