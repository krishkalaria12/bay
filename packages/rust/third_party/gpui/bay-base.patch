+#[derive(Clone, Copy, Default)]
+struct GlassLook {
+    tint: Option<Rgba>,
+    style: LiquidGlassStyle,
+    group_id: Option<u64>,
+    alpha: Option<f32>,
+    frame: Option<GlassFrame>,
+}
