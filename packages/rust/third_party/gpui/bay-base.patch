+enum CornerShape {
+    Square,
+    Rounded {
+        radius: f64,
+        corners: usize,
+    },
+    Masked {
+        frame: [f64; 4],
+        radius: f64,
+        corners: usize,
+    },
+    Shaped {
+        container: [f64; 2],
+        frame: [f64; 4],
+        radii: [f64; 4],
+    },
