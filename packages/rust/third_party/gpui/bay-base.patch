+fn merge_units<V>(first: Vec<(DrawOrder, V)>, second: Vec<(DrawOrder, V)>) -> Vec<(DrawOrder, V)> {
+    let mut merged = first;
+    merged.extend(second);
+    merged.sort_by_key(|(order, _)| *order);
+    merged
