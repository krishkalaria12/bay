+    fn stretch(
+        origin: (f32, f32),
+        scale: (f32, f32),
+        degrees: f32,
+        parent: Option<PaintTransform>,
+    ) -> PaintTransform {
+        PaintTransform::about(
+            point(ScaledPixels(origin.0), ScaledPixels(origin.1)),
+            point(scale.0, scale.1),
+            Radians(degrees.to_radians()),
+            scaled(-1000., -1000., 4000., 4000.),
+            parent,
+        )
+    }
