+            let effect: *mut AnyObject = msg_send![class!(NSVisualEffectView), alloc];
+            let effect: *mut AnyObject = msg_send![effect, initWithFrame: frame];
+            let effect = Retained::from_raw(effect).expect("an NSVisualEffectView");
