{
  "name": "@bay/shaders",
  "version": "0.0.0",
  "private": true,
  "description": "Bay's decorative shaders: Metal on macOS, WebGL2 on Windows and Linux",
  "main": "src/index.tsx",
  "browser": "./src/index.web.tsx",
  "types": "src/index.tsx",
  "exports": {
    ".": {
      "browser": "./src/index.web.tsx",
      "react-native": "./src/index.tsx",
      "default": "./src/index.tsx"
    }
  },
  "scripts": {
    "typecheck": "tsc -p . && tsc -p tsconfig.web.json",
    "test": "node --import ../platform/src/test-loader.mjs --test \"src/**/*.test.mjs\"",
    "test:web": "node scripts/check-web-shaders.mjs",
    "shaders:check": "node scripts/check-shaders.mjs"
  },
  "dependencies": {
    "@bay/platform": "workspace:*"
  },
  "peerDependencies": {
    "expo": "*",
    "react": "*",
    "react-native": "*"
  }
}
