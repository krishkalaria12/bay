{
  "name": "bay",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "start": "bash scripts/run-app",
    "dev:app": "bash scripts/dev-app",
    "dev": "turbo run dev --filter=@bay/browser",
    "macos": "pnpm --filter @bay/browser macos",
    "pods": "pnpm --filter @bay/browser pods",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "shaders:check": "turbo run shaders:check",
    "compiler:check": "turbo run compiler:check",
    "test": "turbo run test",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "devDependencies": {
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "turbo": "^2.11.3",
    "typescript": "~5.9.2"
  },
  "packageManager": "pnpm@11.1.3"
}
