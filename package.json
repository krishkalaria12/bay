{
  "name": "bay",
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "start": "bash scripts/run-app",
    "dev:app": "bash scripts/dev-app",
    "dev": "turbo run dev --filter=@bay/browser",
    "macos": "pnpm --filter @bay/browser macos",
    "pods": "pnpm --filter @bay/browser pods",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "shaders:check": "turbo run shaders:check",
    "test": "turbo run test",
    "windows": "node scripts/windows/run-python.mjs build-app.py",
    "windows:engine": "node scripts/windows/run-python.mjs engine.py",
    "windows:package": "pwsh -File scripts/windows/package.ps1",
    "test:windows-build": "node scripts/windows/run-python.mjs -m unittest discover -s scripts/windows -p \"test_*.py\"",
    "test:windows-native": "node scripts/windows/run-python.mjs test-native.py",
    "windows:build": "node scripts/windows/run-python.mjs build-app.py",
    "web": "pnpm --filter @bay/browser web",
    "build:web": "pnpm --filter @bay/browser build:web",
    "typecheck:web": "pnpm --filter @bay/browser typecheck:web"
  },
  "devDependencies": {
    "turbo": "^2.11.3",
    "typescript": "~5.9.2"
  },
  "license": "Apache-2.0"
}
