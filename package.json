{
  "name": "bay",
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "dev": "turbo run dev --filter=@bay/browser",
    "macos": "pnpm --filter @bay/browser macos",
    "pods": "pnpm --filter @bay/browser pods",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "shaders:check": "turbo run shaders:check",
    "test": "turbo run test && node --no-warnings --test extras/raycast-bay/src/scripts.test.ts"
  },
  "devDependencies": {
    "turbo": "^2.11.3",
    "typescript": "~5.9.2"
  },
  "license": "Apache-2.0"
}
