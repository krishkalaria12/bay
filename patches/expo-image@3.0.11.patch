diff --git a/ios/ImagePlatform.swift b/ios/ImagePlatform.swift
new file mode 100644
index 0000000000000000000000000000000000000000..e44070af3d42ded9ae0a8837816ad4663b60f08a
--- /dev/null
+++ b/ios/ImagePlatform.swift
@@ -0,0 +1,35 @@
+// Copyright 2022-present 650 Industries. All rights reserved.
+
+#if os(macOS)
+import AppKit
+
+typealias UIImage = NSImage
+typealias UIColor = NSColor
+
+extension NSImage {
+  var cgImage: CGImage? {
+    cgImage(forProposedRect: nil, context: nil, hints: nil)
+  }
+
+  var scale: CGFloat {
+    guard size.width > 0, let representation = representations.first(where: { $0.pixelsWide > 0 }) else {
+      return 1
+    }
+    return CGFloat(representation.pixelsWide) / size.width
+  }
+
+  convenience init(cgImage: CGImage) {
+    self.init(cgImage: cgImage, size: CGSize(width: cgImage.width, height: cgImage.height))
+  }
+}
+
+// The hash encoders draw through the platform graphics context to respect image orientation.
+func UIGraphicsPushContext(_ context: CGContext) {
+  NSGraphicsContext.saveGraphicsState()
+  NSGraphicsContext.current = NSGraphicsContext(cgContext: context, flipped: true)
+}
+
+func UIGraphicsPopContext() {
+  NSGraphicsContext.restoreGraphicsState()
+}
+#endif
