<?xml version="1.0" encoding="utf-8"?>
<!-- The "Bay" wallpaper's sky, top to bottom: day, or night in dark mode. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:centerColor="@color/widget_sky_middle"
        android:endColor="@color/widget_sky_bottom"
        android:startColor="@color/widget_sky_top" />
    <corners android:radius="@dimen/widget_radius" />
</shape>
