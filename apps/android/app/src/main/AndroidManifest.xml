<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Lock private tabs asks for a fingerprint, face or the screen lock through BiometricPrompt, which needs it. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- The import sheet lists the other browsers on the phone (Android 11+ hides other apps without a query). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".BayApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="Bay"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Bay"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|fontScale|density"
            android:launchMode="singleTask"
            android:supportsPictureInPicture="true"
            android:windowSoftInputMode="adjustResize">
            <!--
                Links from other apps (B9), which also lets Android offer Bay as the default browser, and the `bay://`
                commands the app shortcuts and the search widget send.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="bay" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
            <!-- Text shared to Bay opens the first web address in it. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <!--
            The launcher entry: one alias per home screen icon (AppIcons.kt), only the chosen one enabled. Android reads the
            app shortcuts (long press on the icon) from the launcher entry, so each alias names them.
        -->
        <activity-alias
            android:name="in.krishkalaria.bay.mobile.MainActivityDefault"
            android:enabled="true"
            android:exported="true"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity-alias>
        <activity-alias
            android:name="in.krishkalaria.bay.mobile.MainActivityNavy"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_navy"
            android:roundIcon="@mipmap/ic_launcher_navy"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity-alias>
        <activity-alias
            android:name="in.krishkalaria.bay.mobile.MainActivityCoral"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_coral"
            android:roundIcon="@mipmap/ic_launcher_coral"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity-alias>
        <activity-alias
            android:name="in.krishkalaria.bay.mobile.MainActivityNoir"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_noir"
            android:roundIcon="@mipmap/ic_launcher_noir"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity-alias>
        <activity-alias
            android:name="in.krishkalaria.bay.mobile.MainActivityCobalt"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_cobalt"
            android:roundIcon="@mipmap/ic_launcher_cobalt"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity-alias>
        <activity-alias
            android:name="in.krishkalaria.bay.mobile.MainActivityBridge"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_bridge"
            android:roundIcon="@mipmap/ic_launcher_bridge"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity-alias>
        <receiver
            android:name="bay.app.BaySearchWidget"
            android:exported="false"
            android:label="@string/search_widget_hint">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/search_widget_info" />
        </receiver>
    </application>
</manifest>
