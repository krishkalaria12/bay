<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".BayApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="Bay"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Bay"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|uiMode"
            android:supportsPictureInPicture="true"
            android:windowSoftInputMode="adjustResize" />
        <!--
            The launcher entry: one alias per home screen icon (AppIcons.kt), only the chosen one enabled. They keep the Expo
            app's component names, so the icon someone picked there stays after the update.
        -->
        <activity-alias
            android:name="in.krishkalaria.bay.mobile.MainActivityDefault"
            android:enabled="true"
            android:exported="true"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name="in.krishkalaria.bay.mobile.MainActivityNavy"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_navy"
            android:roundIcon="@mipmap/ic_launcher_navy"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name="in.krishkalaria.bay.mobile.MainActivityCoral"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_coral"
            android:roundIcon="@mipmap/ic_launcher_coral"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name="in.krishkalaria.bay.mobile.MainActivityNoir"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_noir"
            android:roundIcon="@mipmap/ic_launcher_noir"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name="in.krishkalaria.bay.mobile.MainActivityCobalt"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_cobalt"
            android:roundIcon="@mipmap/ic_launcher_cobalt"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name="in.krishkalaria.bay.mobile.MainActivityBridge"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_bridge"
            android:roundIcon="@mipmap/ic_launcher_bridge"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
