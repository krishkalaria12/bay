{
  "expo": {
    "name": "Bay",
    "slug": "bay",
    "version": "1.0.0",
    // Rotating shows landscape (B10): mostly for fullscreen video, with the chrome keeping clear of the notch on
    // either side. "default" turns this into all orientations with no Android lock attribute.
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    // Bay's own links, plus the web schemes it answers as a browser: iOS reads them for the default-browser offer and
    // the Android VIEW filter takes them with BROWSABLE, so links from other apps open here (B9).
    "scheme": ["bay", "http", "https"],
    "userInterfaceStyle": "automatic",
    "ios": {
      // Bay has no tablet layout yet (D7): a build that says it runs on iPad invites App Store questions for nothing.
      "supportsTablet": false,
      "bundleIdentifier": "in.krishkalaria.bay.mobile",
      "infoPlist": {
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true,
        "UIBackgroundModes": ["audio"],
        "NSLocationWhenInUseUsageDescription": "Bay shares your location with sites you allow.",
        // The import sheet lists the browsers on the phone by asking whether each one's URL scheme opens
        // (src/import/browsers.ts); iOS answers only for the schemes named here.
        "LSApplicationQueriesSchemes": ["googlechrome", "firefox", "microsoft-edge-https", "brave", "ddgQuickLink"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#F1EADF"
      },
      "predictiveBackGestureEnabled": false,
      "package": "in.krishkalaria.bay.mobile",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "plugins": [
      "./modules/bay-engine/app.plugin.js",
      "expo-router",
      // The icons people can switch to in Settings › Appearance (src/panels/appIcons.ts); scripts/make-icon.sh at the repo
      // root draws them. Android launches through an activity alias per icon, so the browser's link filters stay on
      // MainActivity.
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "Navy",
            "ios": "./assets/images/app-icons/navy.png",
            "android": { "foregroundImage": "./assets/images/app-icons/navy-adaptive.png", "backgroundColor": "#141831" }
          },
          {
            "name": "Coral",
            "ios": "./assets/images/app-icons/coral.png",
            "android": { "foregroundImage": "./assets/images/app-icons/coral-adaptive.png", "backgroundColor": "#D9482A" }
          },
          {
            "name": "Noir",
            "ios": "./assets/images/app-icons/noir.png",
            "android": { "foregroundImage": "./assets/images/app-icons/noir-adaptive.png", "backgroundColor": "#050505" }
          },
          {
            "name": "Cobalt",
            "ios": "./assets/images/app-icons/cobalt.png",
            "android": { "foregroundImage": "./assets/images/app-icons/cobalt-adaptive.png", "backgroundColor": "#14286B" }
          },
          {
            "name": "Bridge",
            "ios": "./assets/images/app-icons/bridge.png",
            "android": { "foregroundImage": "./assets/images/app-icons/bridge-adaptive.png", "backgroundColor": "#151C36" }
          }
        ]
      ],
      // The launch screen, as Chrome and Brave draw theirs: Bay's icon still on the phone's own light or dark ground,
      // the app's background colour in each, only until the tabs are loaded (src/app/index.tsx hides it).
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/bay-mark.png",
          "imageWidth": 96,
          "resizeMode": "contain",
          "backgroundColor": "#F5F5F5",
          "dark": { "image": "./assets/images/bay-mark.png", "backgroundColor": "#060607" }
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Bay uses Face ID to unlock your private tabs."
        }
      ],
      "expo-status-bar",
      // Android draws its navigation bar over Bay, see-through: no contrast scrim (a white strip on phones in light
      // mode, opaque on some), and buttons that follow Bay's own theme (src/app/_layout.tsx).
      ["expo-navigation-bar", { "enforceContrast": false }],
      [
        "expo-dev-client",
        {
          "defaultLaunchURL": "http://127.0.0.1:8081",
          "skipOnboarding": true,
          "showMenuAtLaunch": false,
          "toolsButton": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": false,
          "cameraPermission": "Bay uses the camera when a site asks to take a photo or video.",
          "microphonePermission": "Bay uses the microphone when a site asks to record audio."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
