#!/usr/bin/env bash
# Builds the dev client for iOS and Android together and installs each on its device, booting the
# iOS simulator and the Android emulator first. Metro runs separately (pnpm start); both apps load
# their JavaScript from it.
#
#   scripts/native               both platforms, in parallel
#   scripts/native ios           one platform
#   scripts/native android
#
# Devices: see scripts/lib/devices.sh.
# Logs: .expo/logs/native-<platform>.log
set -euo pipefail
cd "$(dirname "$0")/.."

source scripts/lib/devices.sh
parse_platforms "$@"

build() {
  local platform=$1 log=.expo/logs/native-$1.log
  # The Rust content blocker first (cargo skips it when nothing changed).
  bash scripts/adblock "$platform" >"$log" 2>&1 || return 1
  # Bay's engine for Android, as android-engine.json pins it (nothing to do once it's installed).
  if [[ $platform == android ]]; then node scripts/fetch-android-engine.mjs >>"$log" 2>&1 || return 1; fi
  # ios/ and android/ are generated: re-sync them with app.json and the config plugins first.
  CI=1 npx expo prebuild --platform "$platform" </dev/null >>"$log" 2>&1 || return 1
  if [[ $platform == ios ]]; then
    boot_ios >/dev/null && npx expo run:ios --no-bundler --device "$ios_simulator" </dev/null >>"$log" 2>&1
  else
    boot_android >/dev/null && npx expo run:android --no-bundler --device "$android_avd" </dev/null >>"$log" 2>&1
  fi
}

mkdir -p .expo/logs
pids=()
for platform in "${platforms[@]}"; do
  echo "native: building $platform (log: .expo/logs/native-$platform.log)"
  build "$platform" &
  pids+=($!)
done

failed=0
for i in "${!platforms[@]}"; do
  if wait "${pids[$i]}"; then
    echo "native: ${platforms[$i]} installed"
  else
    echo "native: ${platforms[$i]} failed; last lines of .expo/logs/native-${platforms[$i]}.log:" >&2
    tail -20 ".expo/logs/native-${platforms[$i]}.log" >&2
    failed=1
  fi
done
exit $failed
