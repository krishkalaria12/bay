{
  "name": "@bay/browser",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "dev": "react-native start",
    "macos": "xcodebuild -workspace macos/Bay.xcworkspace -scheme Bay-macOS -derivedDataPath build -destination 'platform=macOS,arch=arm64' -quiet -configuration Debug && open -n --env BAY_DATA_DIR=\"${BAY_DATA_DIR:-$HOME/Library/Application Support/Bay Dev}\" build/Build/Products/Debug/Bay.app",
    "pods": "cd macos && pod install",
    "build": "xcodebuild -workspace macos/Bay.xcworkspace -scheme Bay-macOS -derivedDataPath build -destination 'platform=macOS,arch=arm64' -quiet -configuration Release",
    "typecheck": "tsc -p .",
    "compiler:check": "node scripts/compiler-check.mjs",
    "test:folders": "node scripts/nested-folders-test.mjs",
    "dev:folders": "node scripts/nested-folders-demo.mjs",
    "test": "node --no-warnings --import ./src/test-loader.mjs --test \"src/**/*.test.mjs\""
  },
  "dependencies": {
    "@bay/core": "workspace:*",
    "@bay/import": "workspace:*",
    "@bay/nncore": "workspace:*",
    "@bay/shaders": "workspace:*",
    "@bay/shell": "workspace:*",
    "@bay/sync": "workspace:*",
    "expo": "~54.0.37",
    "expo-modules-core": "~3.0.29",
    "react": "19.1.4",
    "react-native": "0.81.6",
    "react-native-macos": "0.81.9",
    "react-native-reanimated": "3.19.5",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@react-native-community/cli": "^20.0.0",
    "@react-native-community/cli-platform-apple": "^20.0.0",
    "@react-native-community/cli-platform-ios": "^20.0.0",
    "@react-native/babel-preset": "0.81.6",
    "@react-native/metro-config": "0.81.6",
    "@types/react": "~19.1.10",
    "babel-plugin-react-compiler": "^1.0.0",
    "babel-preset-expo": "~54.0.0",
    "typescript": "~5.9.2"
  }
}
