---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Sticky from "../components/Sticky.astro";
---

<Layout title="Page not found | Bay" description="This page isn’t here." noindex>
  <Header />
  <main class="mx-auto max-w-3xl px-5 py-24 text-center">
    <Sticky tilt={-2} class="mx-auto max-w-sm px-8 py-8">
      <p class="text-[36px] leading-[1.05]">This tab was put away a while ago.</p>
    </Sticky>
    <h1 class="mt-12 text-[32px] font-bold tracking-[-0.03em]">Page not found</h1>
    <p class="mt-3 text-[16px] text-muted">The address may be old, or mistyped.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-2">
      <a href="/" class="btn">Go to Bay’s home page</a>
      <a href="/#inside" class="btn-ghost">See what’s inside ›</a>
    </div>
  </main>
  <Footer />
</Layout>
