---
import { Image } from "astro:assets";
import appIcon from "../assets/app-icon.png";
import { site } from "../site";
---

<header class="sticky top-0 z-50 bg-paper/80 backdrop-blur-md">
  <nav class="mx-auto flex h-16 max-w-6xl items-center gap-6 px-5" aria-label="Main">
    <a href="/" class="flex items-center gap-2 text-[21px] font-bold tracking-tight" aria-label="Bay home">
      <Image src={appIcon} alt="" width={30} height={30} class="size-[30px]" loading="eager" />
      Bay
    </a>
    <ul class="ml-auto hidden items-center gap-1 text-[14px] font-medium text-muted md:flex">
      <li><a class="rounded-lg px-3 py-2 hover:text-ink" href="/#arc">From Arc</a></li>
      <li><a class="rounded-lg px-3 py-2 hover:text-ink" href="/switch-from-arc/">Switch from Arc</a></li>
      <li><a class="rounded-lg px-3 py-2 hover:text-ink" href="/#more">More than Arc</a></li>
      <li><a class="rounded-lg px-3 py-2 hover:text-ink" href="/#faq">FAQ</a></li>
    </ul>
    <a href={site.downloadUrl} data-download-location="header" class="btn ml-auto px-4 py-2.5 text-[14px] md:ml-0">Download for Mac</a>
  </nav>
</header>
