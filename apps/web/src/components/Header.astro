---
import { Image } from "astro:assets";
import appIcon from "../assets/app-icon.png";
import { downloadLink, site } from "../site";
---

<!-- The same on every page: kept in place as the client router swaps the rest. -->
<header class="sticky top-0 z-50 bg-paper/80 backdrop-blur-md" transition:persist="site-header">
  <nav class="mx-auto flex h-16 max-w-6xl items-center gap-6 px-5" aria-label="Main">
    <a href="/" class="flex items-center gap-2 text-[21px] font-bold tracking-tight" aria-label="Bay home">
      <Image src={appIcon} alt="" width={30} height={30} class="size-[30px]" loading="eager" />
      Bay
    </a>
    <ul class="ml-auto hidden items-center gap-1 text-[14px] font-medium text-muted md:flex">
      <li><a class="rounded-lg px-3 py-2 hover:text-ink" href="/#inside">Features</a></li>
      <li><a class="rounded-lg px-3 py-2 hover:text-ink" href="/#privacy">Privacy</a></li>
      <li><a class="rounded-lg px-3 py-2 hover:text-ink" href="/#more">Extras</a></li>
      <li><a class="rounded-lg px-3 py-2 hover:text-ink" href="/#faq">FAQ</a></li>
      <li><a class="rounded-lg px-3 py-2 hover:text-ink" href="/release-notes/">What’s New</a></li>
    </ul>
    <a
      href={site.github}
      class="ml-auto inline-flex size-10 items-center justify-center rounded-lg text-muted transition hover:bg-black/5 hover:text-ink md:ml-0"
      aria-label="Bay on GitHub"
      title="Bay on GitHub"
    >
      <svg viewBox="0 0 16 16" class="size-5" fill="currentColor" aria-hidden="true">
        <path
          d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
        ></path>
      </svg>
    </a>
    <a href={site.downloadUrl} {...downloadLink} data-download-location="header" class="btn px-4 py-2.5 text-[14px]">Download for Mac</a>
  </nav>
</header>
