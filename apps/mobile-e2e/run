#!/usr/bin/env bash
# Runs every Argent e2e test in .argent/e2e on the Android emulator, or the platforms named. Install the debug builds
# first (apps/android/AGENTS.md, apps/ios/AGENTS.md). Boots the devices if needed and serves .argent/pages at
# 127.0.0.1:8099 for the tests that open them. Android is the default: Argent's runner doesn't see SwiftUI's
# accessibility identifiers yet (docs/mobile-native-plan.html, Known gaps), so on iOS the flows are checked by hand.
#
#   apps/mobile-e2e/run                  every test on Android
#   apps/mobile-e2e/run ios android      the platforms named
#
# IOS_SIMULATOR (default "iPhone 18 Pro") and ANDROID_AVD (default "bay-pixel") pick the devices.
set -euo pipefail
cd "$(dirname "$0")"

ios_simulator=${IOS_SIMULATOR:-iPhone 18 Pro}
android_avd=${ANDROID_AVD:-bay-pixel}
export DEVELOPER_DIR=${DEVELOPER_DIR:-/Applications/Xcode.app/Contents/Developer}
export ANDROID_HOME=${ANDROID_HOME:-$HOME/Library/Android/sdk}
adb=$ANDROID_HOME/platform-tools/adb
port=8099

platforms=("$@")
((${#platforms[@]})) || platforms=(android)
for platform in "${platforms[@]}"; do
  [[ $platform == ios || $platform == android ]] || { echo "unknown platform '$platform' (ios or android)" >&2; exit 2; }
done

# Boots the simulator if needed and prints its UDID.
boot_ios() {
  xcrun simctl bootstatus "$ios_simulator" -b >/dev/null
  xcrun simctl list devices booted -j | python3 -I -c 'import json, sys
name = sys.argv[1]
for devices in json.load(sys.stdin)["devices"].values():
    for d in devices:
        if d["name"] == name:
            print(d["udid"]); raise SystemExit' "$ios_simulator"
}

# Starts the emulator if none is running, waits for boot, forwards the pages' port, and prints its serial.
boot_android() {
  if ! "$adb" devices | grep -q '^emulator-'; then
    # With audio, so pages' media can play (with -no-audio it never starts); the media stream is muted below.
    "$ANDROID_HOME/emulator/emulator" -avd "$android_avd" >/dev/null 2>&1 &
  fi
  "$adb" wait-for-device
  until [[ $("$adb" shell getprop sys.boot_completed 2>/dev/null | tr -d '\r') == 1 ]]; do sleep 2; done
  # A cold boot can leave a "System UI isn't responding" dialog over the app; close system dialogs.
  "$adb" shell am broadcast -a android.intent.action.CLOSE_SYSTEM_DIALOGS >/dev/null 2>&1 || true
  "$adb" shell cmd audio set-volume 3 0 >/dev/null 2>&1 || true
  "$adb" reverse tcp:$port tcp:$port >/dev/null
  "$adb" devices | awk '/^emulator-/ { print $1; exit }'
}

python3 -I -m http.server $port --bind 127.0.0.1 --directory . >/dev/null 2>&1 &
server=$!
trap 'kill $server' EXIT

failed=0
for platform in "${platforms[@]}"; do
  if [[ $platform == ios ]]; then device=$(boot_ios); else device=$(boot_android); fi
  echo "e2e: $platform ($device)"
  argent e2e run .argent/e2e --recursive --platform "$platform" --device "$device" || failed=1
done
exit $failed
