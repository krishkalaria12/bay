#!/usr/bin/env node
// PreToolUse hook: refuses git commands that throw away working-tree changes. Everyone works in this
// checkout, so `git checkout -- <file>` on "your own" file also wipes another agent's unsaved edits.
// Undo your own hunks by editing; read old versions with `git show <rev>:<path>`.
// Exit 2 blocks the call and shows the message to the agent.
const { readFileSync } = require("node:fs");

let command;
try {
  command = JSON.parse(readFileSync(0, "utf8")).tool_input?.command ?? "";
} catch {
  process.exit(0);
}

// Only git where a command starts (after ;, &&, |, a subshell or env assignments), so grep/echo of the text pass.
const G = "(?:^|[;&|(`\\n]\\s*|\\$\\(\\s*)(?:\\w+=\\S*\\s+)*git\\s+(?:-C\\s+\\S+\\s+)?";
const rules = [
  [G + "checkout\\b(?!\\s+-b\\b)", "git checkout"],
  [G + "restore\\b(?![^;&|\\n]*--staged)", "git restore (without --staged)"],
  [G + "stash\\b", "git stash"],
  [G + "reset\\b[^;&|\\n]*--hard", "git reset --hard"],
  [G + "clean\\b", "git clean"],
  [G + "switch\\b", "git switch"],
];
for (const [pattern, name] of rules) {
  if (new RegExp(pattern).test(command)) {
    console.error(
      `Blocked: ${name} in the shared checkout wipes other agents' uncommitted work. ` +
        "Undo your own hunks by editing the file; read an old version with `git show <rev>:<path>`; " +
        "unstage with `git restore --staged <path>`.",
    );
    process.exit(2);
  }
}
