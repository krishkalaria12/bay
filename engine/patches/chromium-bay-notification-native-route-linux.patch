+#if BUILDFLAG(IS_LINUX)
+TEST_F(BaseNotificationDisplayServiceImplTest,
+       BayNativeRouteDoesNotFollowPreferenceAfterConstruction) {
+  base::test::ScopedFeatureList features;
+  features.InitWithFeatures(
+      {features::kNativeNotifications, features::kSystemNotifications}, {});
+  profile()->GetPrefs()->SetBoolean(prefs::kAllowSystemNotifications, false);
+  NotificationDisplayServiceImpl fallback(profile());
+  EXPECT_FALSE(fallback.UsesSystemNotificationBridge());
+
+  // The preference changes what a new service selects. It cannot change the
+  // route already selected by this service, even if the global bridge is ready.
+  profile()->GetPrefs()->SetBoolean(prefs::kAllowSystemNotifications, true);
+  EXPECT_FALSE(fallback.UsesSystemNotificationBridge());
+}
