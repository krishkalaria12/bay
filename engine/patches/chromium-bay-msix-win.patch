+// Bay's Microsoft Store package. Windows keeps the files a package creates in
+// AppData private but lets it change the ones already there, so it can't share
+// the installer's folder: both copies would open one profile, each blind to
+// the other's lock.
+bool IsBayPackage() {
+  // Looked up rather than imported, as chrome_elf's imports are fixed.
+  using GetCurrentPackageFamilyNameFunction = LONG(WINAPI*)(UINT32*, PWSTR);
+  const auto get_name = reinterpret_cast<GetCurrentPackageFamilyNameFunction>(
+      ::GetProcAddress(::GetModuleHandleW(L"kernel32.dll"),
+                       "GetCurrentPackageFamilyName"));
+  UINT32 length = 0;
+  // Outside a package this fails with APPMODEL_ERROR_NO_PACKAGE.
+  return get_name && get_name(&length, nullptr) == ERROR_INSUFFICIENT_BUFFER;
+}
+
