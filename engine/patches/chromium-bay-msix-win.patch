+// The running package's family name, or empty outside a package.
+std::wstring GetPackageFamilyName() {
+  // Looked up rather than imported, so chrome.dll's imports stay as they are.
+  const auto get_name =
+      reinterpret_cast<decltype(&::GetCurrentPackageFamilyName)>(
+          ::GetProcAddress(::GetModuleHandleW(L"kernel32.dll"),
+                           "GetCurrentPackageFamilyName"));
+  UINT32 length = 0;
+  if (!get_name || get_name(&length, nullptr) != ERROR_INSUFFICIENT_BUFFER ||
+      !length) {
+    return std::wstring();
+  }
+  std::wstring name(length, L'\0');
+  if (get_name(&length, name.data()) != ERROR_SUCCESS || !length) {
+    return std::wstring();
+  }
+  name.resize(length - 1);  // `length` counts the terminating null.
+  return name;
+}
