+// Bay's Microsoft Store package: whether `prog_id`, a default handler Windows
+// reports, opens this package's app. A package's handlers are ProgIDs Windows
+// names itself (AppX...), each recording its app's ID.
+bool IsPackageProgId(const wchar_t* prog_id) {
+  const std::wstring& package_id = InstallUtil::GetPackageAppUserModelId();
+  if (package_id.empty())
+    return false;
+  base::win::RegKey key;
+  std::wstring app_id;
+  return key.Open(HKEY_CLASSES_ROOT,
+                  base::StrCat({prog_id, L"\\Application"}).c_str(),
+                  KEY_QUERY_VALUE) == ERROR_SUCCESS &&
+         key.ReadValue(L"AppUserModelID", &app_id) == ERROR_SUCCESS &&
+         app_id == package_id;
 }
 
