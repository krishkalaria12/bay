+const std::wstring& InstallUtil::GetPackageAppUserModelId() {
+  static const base::NoDestructor<std::wstring> id([] {
+    // Looked up rather than imported, so the binaries' imports stay as they
+    // are.
+    const auto get_id =
+        reinterpret_cast<decltype(&::GetCurrentApplicationUserModelId)>(
+            ::GetProcAddress(::GetModuleHandleW(L"kernel32.dll"),
+                             "GetCurrentApplicationUserModelId"));
+    UINT32 length = 0;
+    // Outside a package this fails with APPMODEL_ERROR_NO_APPLICATION.
+    if (!get_id || get_id(&length, nullptr) != ERROR_INSUFFICIENT_BUFFER ||
+        !length) {
+      return std::wstring();
+    }
+    std::wstring value(length, L'\0');
+    if (get_id(&length, value.data()) != ERROR_SUCCESS || !length) {
+      return std::wstring();
+    }
+    value.resize(length - 1);  // `length` counts the terminating null.
+    return value;
+  }());
+  return *id;
+}
