 base::FilePath GetChromeProxyPath() {
+  // Started from the package's own folder, Bay would run outside the package:
+  // another app to Windows, without the package's data. A Store copy's
+  // shortcuts go through the alias Windows keeps in the user's WindowsApps.
+  static const base::NoDestructor<std::wstring> family(GetPackageFamilyName());
+  base::FilePath local_app_data;
+  if (!family->empty() &&
+      base::PathService::Get(base::DIR_LOCAL_APP_DATA, &local_app_data)) {
+    return local_app_data.Append(FILE_PATH_LITERAL("Microsoft"))
+        .Append(FILE_PATH_LITERAL("WindowsApps"))
+        .Append(*family)
+        .Append(kPackageAlias);
+  }
   base::FilePath chrome_dir;
   CHECK(base::PathService::Get(base::DIR_EXE, &chrome_dir));
   return chrome_dir.Append(kChromeProxyExecutable);
