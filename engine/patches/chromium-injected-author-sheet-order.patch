+TEST_F(StyleEngineTest, InjectAuthorSheetAfterDocument) {
+  SetBodyInnerHTML("<div id=target></div><div id=important></div>");
+  auto inject = [&](const char* key, const char* css,
+                    WebStyleSheetInsertionOrder order) {
+    auto* sheet = MakeGarbageCollected<StyleSheetContents>(
+        MakeGarbageCollected<CSSParserContext>(GetDocument()));
+    sheet->ParseString(css);
+    GetStyleEngine().InjectSheet(StyleSheetKey(key), sheet,
+                                 WebCssOrigin::kAuthor, order);
+  };
+  auto color = [&](const char* id) {
+    UpdateAllLifecyclePhases();
+    return GetDocument()
+        .getElementById(AtomicString(id))
+        ->GetComputedStyle()
+        ->VisitedDependentColor(GetCSSPropertyColor());
+  };
+  // Insert before the page's sheets exist, as document-start injection does.
+  inject("ordinary", "div { color: blue; }",
+         WebStyleSheetInsertionOrder::kBeforeDocument);
+  inject("boost", "div { color: green; }",
+         WebStyleSheetInsertionOrder::kAfterDocument);
+  GetDocument().head()->SetInnerHTMLWithoutTrustedTypes(
+      "<style>div { color: red; } #important { color: red !important; }</style>");
+  EXPECT_EQ(Color::FromRGB(0, 128, 0), color("target"));
+  EXPECT_EQ(Color::FromRGB(255, 0, 0), color("important"));
+
+  auto* adopted = CSSStyleSheet::Create(
+      GetDocument(), CSSStyleSheetInit::Create(), ASSERT_NO_EXCEPTION);
+  adopted->replaceSync("div { color: purple; }", ASSERT_NO_EXCEPTION);
+  HeapVector<Member<CSSStyleSheet>> adopted_sheets;
+  adopted_sheets.push_back(adopted);
+  GetDocument().SetAdoptedStyleSheetsForTesting(adopted_sheets);
+  EXPECT_EQ(Color::FromRGB(0, 128, 0), color("target"));
+
+  inject("later-boost", "div { color: yellow; }",
+         WebStyleSheetInsertionOrder::kAfterDocument);
+  ThreadState::Current()->CollectAllGarbageForTesting();
+  EXPECT_EQ(Color::FromRGB(255, 255, 0), color("target"));
+  GetStyleEngine().RemoveInjectedSheet(
+      StyleSheetKey("later-boost"), WebCssOrigin::kAuthor,
+      WebStyleSheetInsertionOrder::kAfterDocument);
+  EXPECT_EQ(Color::FromRGB(0, 128, 0), color("target"));
+  GetStyleEngine().RemoveInjectedSheet(
+      StyleSheetKey("boost"), WebCssOrigin::kAuthor,
+      WebStyleSheetInsertionOrder::kAfterDocument);
+  // The normal injected author sheet still precedes adopted/document sheets.
+  EXPECT_EQ(Color::FromRGB(128, 0, 128), color("target"));
+  adopted_sheets.clear();
+  GetDocument().SetAdoptedStyleSheetsForTesting(adopted_sheets);
+  EXPECT_EQ(Color::FromRGB(255, 0, 0), color("target"));
+}
