+#if BUILDFLAG(IS_LINUX)
+TEST(ShellIntegrationTest, BayBundledXdgSettingsWinsOverPath) {
+  base::ScopedTempDir temp;
+  ASSERT_TRUE(temp.CreateUniqueTempDir());
+  base::ScopedPathOverride executable_directory(base::DIR_EXE, temp.GetPath());
+  const auto distro = temp.GetPath().Append("distro");
+  ASSERT_TRUE(base::CreateDirectory(distro));
+  base::ScopedEnvironmentVariableOverride path("PATH", distro.value());
+  const auto sibling = temp.GetPath().Append("xdg-settings");
+  const auto system = distro.Append("xdg-settings");
+  // Harmless scripts model both backends. Never run real desktop utilities.
+  ASSERT_TRUE(base::WriteFile(sibling,
+                              "#!/bin/sh\nif [ \"$1\" = check ]; then echo "
+                              "yes; exit 0; fi\nexit 23\n"));
+  ASSERT_TRUE(base::WriteFile(system, "#!/bin/sh\necho no\nexit 99\n"));
+  ASSERT_TRUE(base::SetPosixFilePermissions(sibling, 0700));
+  ASSERT_TRUE(base::SetPosixFilePermissions(system, 0700));
+  int exit_code = 0;
+  EXPECT_TRUE(LaunchXdgUtility(
+      {"xdg-settings", "set", "default-web-browser", "bay.desktop"},
+      &exit_code));
+  EXPECT_EQ(exit_code, 23);
+  EXPECT_EQ(shell_integration::GetDefaultBrowser(),
+            shell_integration::IS_DEFAULT);
+}
+
+TEST(ShellIntegrationTest, BayDeveloperBuildCanUsePathWithoutBundledHelper) {
+  base::ScopedTempDir temp;
+  ASSERT_TRUE(temp.CreateUniqueTempDir());
+  const auto empty = temp.GetPath().Append("empty");
+  ASSERT_TRUE(base::CreateDirectory(empty));
+  base::ScopedPathOverride executable_directory(base::DIR_EXE, empty);
+  base::ScopedEnvironmentVariableOverride path("PATH", temp.GetPath().value());
+  const auto helper = temp.GetPath().Append("xdg-settings");
+  ASSERT_TRUE(base::WriteFile(
+      helper,
+      "#!/bin/sh\nif [ \"$1\" = check ]; then echo no; exit 0; fi\nexit 24\n"));
+  ASSERT_TRUE(base::SetPosixFilePermissions(helper, 0700));
+  int exit_code = 0;
+  EXPECT_TRUE(LaunchXdgUtility({"xdg-settings", "set"}, &exit_code));
+  EXPECT_EQ(exit_code, 24);
+  EXPECT_EQ(shell_integration::GetDefaultBrowser(),
+            shell_integration::NOT_DEFAULT);
+}
+#endif  // BUILDFLAG(IS_LINUX)
