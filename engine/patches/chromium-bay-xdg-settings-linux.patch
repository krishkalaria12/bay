 namespace {
 
 const char kXdgSettings[] = "xdg-settings";
+
+// Packaged builds ship a tested helper next to the browser. Keep the PATH
+// fallback for developer builds without a runtime archive.
+std::string XdgSettingsPath() {
+  base::FilePath directory;
+  if (base::PathService::Get(base::DIR_EXE, &directory)) {
+    const auto helper = directory.Append(kXdgSettings);
+    if (base::PathExists(helper))
+      return helper.value();
+  }
+  return kXdgSettings;
+}
