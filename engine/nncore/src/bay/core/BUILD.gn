# NNCore: Bay's own layer over //chrome (the "ArcCore" of Bay).
#
# Linked into Chrome's framework through one dep in //chrome:chrome_dll (see
# engine/nncore/apply.sh), so the framework that comes out of `chrome_framework`
# is NNCore: //chrome's services plus our BrowserWindow, window host and ObjC API.
# A host app links the framework and drives it through public/NNCore.h.

assert(is_mac || is_win)

if (is_mac) {

config("exports") {
  # Chrome's framework exports only ChromeMain; keep our API visible too.
  ldflags = [ "-Wl,-exported_symbols_list," +
              rebase_path("nncore.exports", root_build_dir) ]
}

source_set("core") {
  sources = [
    "nn_autofill_prompt.h",
    "nn_autofill_prompt.mm",
    "nn_autofill_trigger.h",
    "nn_autofill_trigger.mm",
    "nn_browser.h",
    "nn_browser.mm",
    "nn_browser_window.h",
    "nn_browser_window.mm",
    "nn_cast_dialog.h",
    "nn_cast_dialog.mm",
    "nn_context_menu.h",
    "nn_context_menu.mm",
    "nn_desktop_capture.h",
    "nn_desktop_capture.cc",
    "nn_devtools_call.h",
    "nn_devtools_call.cc",
    "nn_device_chooser.h",
    "nn_device_chooser.mm",
    "nn_extension_view.h",
    "nn_extension_view.mm",
    "nn_external_apps.h",
    "nn_external_apps.mm",
    "nn_fake_media.h",
    "nn_fake_media.mm",
    "nn_host_visibility.h",
    "nn_host_visibility.cc",
    "nn_icon_fetch.mm",
    "nn_installed_bubble.h",
    "nn_installed_bubble.mm",
    "nn_lifetime.h",
    "nn_lifetime.mm",
    "nn_main_delegate.cc",
    "nn_main_delegate.h",
    "nn_navigation_hold.mm",
    "nn_navigation_hold.h",
    "nn_page_channel.h",
    "nn_page_channel.mm",
    "nn_password_prompt.h",
    "nn_peek_links.h",
    "nn_peek_links.mm",
    "nn_password_prompt.mm",
    "nn_permissions.h",
    "nn_permissions.mm",
    "nn_picture_in_picture.h",
    "nn_picture_in_picture.mm",
    "nn_strings.cc",
    "nn_strings.h",
    "nn_tab_info.h",
    "nn_test_media_route_provider.cc",
    "nn_test_media_route_provider.h",
    "nn_test_system_permissions.h",
    "nn_test_system_permissions.mm",
    "nn_tab_info.mm",
    "nn_seams.mm",
    "nncore_api.mm",
    "nncore_internal.h",
    "public/NNCore.h",
    "renderer/nn_content_renderer_client.cc",
    "renderer/nn_content_renderer_client.h",
  ]

  # The framework that links this exports our API (an all_dependent config
  # reaches the framework's link through //chrome:chrome_dll).
  all_dependent_configs = [ ":exports" ]

  deps = [
    "//base",
    "//cef/libcef/features:buildflags",
    "//chrome/app:command_ids",
    "//chrome/app:generated_resources",
    "//chrome/browser",
    "//chrome/browser/apps/platform_apps",
    "//chrome/browser/devtools",
    "//chrome/browser/extensions",
    "//chrome/browser/permissions/system",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/printing",
    "//chrome/browser/ui",
    "//chrome/common",
    "//chrome/common/profiler",
    "//components/component_updater",
    "//components/keep_alive_registry",
    "//components/favicon/content",
    "//components/find_in_page",
    "//components/password_manager/core/browser",
    "//components/prefs",
    "//components/remote_cocoa/app_shim",
    "//components/web_modal",
    "//components/zoom",
    "//components/autofill/content/browser",
    "//components/autofill/core/browser",
    "//components/media_router/browser",
    "//components/blocked_content",
    "//components/content_settings/core/browser",
    "//components/permissions",
    "//components/policy/core/common",
    "//net",
    "//pdf:buildflags",
    "//printing/buildflags",
    "//services/network/public/cpp",
    "//services/network/public/mojom",
    "//content/public/browser",
    "//chrome/renderer",
    "//content/public/renderer",
    "//extensions/browser",
    "//gin",
    "//ipc",
    "//media",
    "//mojo/public/cpp/bindings",
    "//bay/core/mojom",
    "//third_party/blink/public:blink",
    "//third_party/blink/public/common",
    "//v8",
    "//skia",
    "//ui/base",
    "//ui/color",
    "//ui/gfx",
    "//ui/views",
  ]

  frameworks = [
    "AppKit.framework",
    "Foundation.framework",
  ]
}

} else if (is_win) {
  # CEF's sandbox bootstrap loads the RNW application DLL. NNCore has a C ABI
  # and only links the public CEF wrapper, keeping Chromium types out of RNW.
  shared_library("nncore") {
    testonly = true
    sources = [ "public/nncore_c.h", "win/nncore_win.cc" ]
    defines = [ "CEF_USE_BOOTSTRAP" ]
    deps = [ "//cef:libcef", "//cef:libcef_dll_wrapper_dll" ]
    libs = [ "user32.lib" ]
  }

  shared_library("nncore_subprocess_dll") {
    testonly = true
    output_name = "nncore_subprocess"
    sources = [ "win/nncore_subprocess.cc" ]
    defines = [ "CEF_USE_BOOTSTRAP" ]
    deps = [ "//cef:bootstrap", "//cef:libcef", "//cef:libcef_dll_wrapper_dll" ]
  }

  copy("nncore_subprocess") {
    testonly = true
    sources = [ "$root_out_dir/bootstrap.exe" ]
    outputs = [ "$root_out_dir/nncore_subprocess.exe" ]
    deps = [ "//cef:bootstrap", ":nncore_subprocess_dll" ]
  }

  group("core") {
    testonly = true
    deps = [ ":nncore", ":nncore_subprocess" ]
  }
}
