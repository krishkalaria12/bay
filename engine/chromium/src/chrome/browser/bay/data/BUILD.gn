# Copyright 2026 Bay. Apache-2.0. apply.py materializes packages/ from the
# canonical repository package sources. These parsers use C++ exceptions
# internally. No exception crosses this target's public data_services.h API or
# enables exceptions in Chromium callers.
assert(is_win || is_linux)

if (is_linux) {
  import("//build/config/features.gni")
  import("//build/config/linux/pkg_config.gni")
  import("//build/config/ui.gni")

  # NSS is loaded at runtime from trusted system locations by the reader.
  pkg_config("import_nss_headers") {
    packages = [ "nss" ]
    ignore_libs = true
  }
}

# This is portable package code and vendored libraries, not Chromium code, so
# Chromium's style and raw_ptr checks don't apply to it.
chromium_style_checks = []
if (is_clang) {
  chromium_style_checks += [ "//build/config/clang:find_bad_constructs" ]
}

static_library("data_services") {
  sources = [
    "data_services.cc",
    "data_services.h",
    "packages/import/portable/BrowserDiscovery.cpp",
    "packages/import/portable/BrowserDiscovery.h",
    "packages/import/portable/ImportCore.h",
    "packages/import/portable/ImportService.cpp",
    "packages/import/portable/Readers.cpp",
    "packages/import/portable/SQLite.h",
    "packages/import/portable/Secrets.cpp",

    # Sync dispatch reads engine passwords through the importer in this target.
    "packages/sync/portable/SyncService.cpp",
    "vendor/nlohmann/json.hpp",
  ]
  configs -= [ "//build/config/compiler:no_exceptions" ]
  configs += [ "//build/config/compiler:exceptions" ]
  configs -= chromium_style_checks

  # rust/: bay_import.h, the import readers' C ABI (Bay's desktop Rust library,
  # linked through :sync_services).
  include_dirs = [
    "vendor",
    "rust",
  ]

  # Native picker adapters use the host-only sync recovery continuation API.
  public_deps = [ ":sync_services" ]
  if (is_win) {
    # Canonical package paths use the C++17 UTF-8 std::string interface, as
    # on Linux below.
    cflags_cc = [ "/Zc:char8_t-" ]
    defines = [
      "NOMINMAX",
      "WIN32_LEAN_AND_MEAN",
    ]
    libs += [
      "advapi32.lib",
      "bcrypt.lib",
      "crypt32.lib",
      "gdi32.lib",
      "ole32.lib",
      "shell32.lib",
      "user32.lib",
      "uuid.lib",
      "winsqlite3.lib",
    ]
  } else {
    sources += [
      "packages/import/linux/ChromiumSecrets.cpp",
      "packages/import/linux/ChromiumSecrets.h",
      "packages/import/linux/FirefoxNSS.cpp",
      "packages/import/linux/FirefoxNSS.h",
      "packages/import/linux/SecretService.cpp",
      "packages/import/linux/SystemLibrary.h",
    ]

    # Canonical package paths use the C++17 UTF-8 std::string interface.
    # Keep Chromium's C++ standard while retaining that source-level contract.
    cflags_cc = [ "-fno-char8_t" ]
    assert(use_gio && use_glib, "Bay Linux import requires GIO")
    configs += [
      ":import_nss_headers",
      "//build/config/linux:glib",
      "//build/linux:gio_config",
    ]
    deps = [
      "//third_party/boringssl",
      "//third_party/sqlite",
    ]
    libs = [ "dl" ]
  }
}

static_library("sync_services") {
  sources = [
    "packages/sync/portable/Base64.h",
    "packages/sync/portable/RecoveryKit.cpp",
    "packages/sync/portable/RecoveryKit.h",
    "packages/sync/portable/RecoveryKitInternal.h",
    "packages/sync/portable/SyncCrypto.cpp",
    "packages/sync/portable/SyncCrypto.h",
    "packages/sync/portable/SyncService.h",
    "packages/sync/portable/SyncVault.cpp",
    "packages/sync/portable/SyncVault.h",
    "packages/sync/portable/vendor/qrcodegen.cpp",
    "packages/sync/portable/vendor/qrcodegen.hpp",
  ]
  configs -= [ "//build/config/compiler:no_exceptions" ]
  configs += [ "//build/config/compiler:exceptions" ]
  configs -= chromium_style_checks
  # vendor/: qrcodegen. rust/: bay_sync.h, the sync format's C ABI, from Bay's
  # desktop Rust library (packages/rust), which scripts/engine.py builds.
  include_dirs = [
    "vendor",
    "rust",
  ]
  if (is_win) {
    # With what Rust's standard library needs on Windows, as webui/BUILD.gn.
    libs = [
      "$root_out_dir/bay_desktop/bay_desktop.lib",
      "ntdll.lib",
      "userenv.lib",
      "ws2_32.lib",
    ]
  } else {
    libs = [ "$root_out_dir/bay_desktop/libbay_desktop.a" ]
  }
  if (is_win) {
    sources += [
      "packages/sync/portable/RecoveryKitWindows.cpp",
      "packages/sync/portable/SyncCryptoWindows.cpp",
    ]
    cflags_cc = [ "/Zc:char8_t-" ]
    defines = [
      "NOMINMAX",
      "WIN32_LEAN_AND_MEAN",
    ]
    libs += [
      "advapi32.lib",
      "bcrypt.lib",
      "crypt32.lib",
      "gdi32.lib",
      "ole32.lib",
      "shell32.lib",
      "user32.lib",
      "uuid.lib",
    ]
  } else if (is_linux) {
    sources += [
      "packages/sync/linux/RecoveryKitLinux.cpp",
      "packages/sync/linux/SyncCryptoLinux.cpp",
      "packages/sync/linux/SyncKeyStore.cpp",
      "packages/sync/linux/SyncPlatformLinux.cpp",
    ]
    configs += [ ":sync_libsecret" ]
    deps = [
      "//base",
      "//skia",
      "//third_party/boringssl",
      "//ui/base/clipboard",
      "//ui/gfx",
    ]
  }
}

if (is_linux) {
  pkg_config("sync_libsecret") {
    packages = [ "libsecret-1" ]
  }
}
