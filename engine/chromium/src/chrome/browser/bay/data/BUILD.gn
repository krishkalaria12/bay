# Copyright 2026 Bay. Apache-2.0. apply.py materializes packages/ from the
# canonical repository package sources. These parsers use C++ exceptions
# internally. No exception crosses this target's public data_services.h API or
# enables exceptions in Chromium callers.
assert(is_win || is_linux)

if (is_linux) {
  import("//build/config/linux/pkg_config.gni")
  import("//build/config/ui.gni")

  # NSS is loaded at runtime from trusted system locations by the reader.
  pkg_config("import_nss_headers") {
    packages = [ "nss" ]
    ignore_libs = true
  }
}

static_library("data_services") {
  sources = [
    "data_services.cc",
    "data_services.h",
    "packages/import/windows/Arc.cpp",
    "packages/import/windows/BrowserDiscovery.cpp",
    "packages/import/windows/BrowserDiscovery.h",
    "packages/import/windows/ImportCore.h",
    "packages/import/windows/ImportService.cpp",
    "packages/import/windows/Readers.cpp",
    "packages/import/windows/SQLite.h",
    "packages/import/windows/Secrets.cpp",
    "packages/import/windows/Sessions.cpp",
    "vendor/nlohmann/json.hpp",
  ]
  configs -= [ "//build/config/compiler:no_exceptions" ]
  configs += [ "//build/config/compiler:exceptions" ]
  include_dirs = [ "vendor" ]
  deps = [ ":sync_services" ]
  if (is_win) {
    defines = [
      "NOMINMAX",
      "WIN32_LEAN_AND_MEAN",
    ]
    libs = [
      "advapi32.lib",
      "bcrypt.lib",
      "crypt32.lib",
      "gdi32.lib",
      "ole32.lib",
      "shell32.lib",
      "user32.lib",
      "uuid.lib",
      "winsqlite3.lib",
    ]
  } else {
    sources += [
      "packages/import/linux/ChromiumSecrets.cpp",
      "packages/import/linux/ChromiumSecrets.h",
      "packages/import/linux/FirefoxNSS.cpp",
      "packages/import/linux/FirefoxNSS.h",
      "packages/import/linux/SecretService.cpp",
      "packages/import/linux/SystemLibrary.h",
    ]

    # Canonical package paths use the C++17 UTF-8 std::string interface.
    # Keep Chromium's C++ standard while retaining that source-level contract.
    cflags_cc = [ "-fno-char8_t" ]
    assert(use_gio && use_glib, "Bay Linux import requires GIO")
    configs += [
      ":import_nss_headers",
      "//build/config/linux:glib",
      "//build/linux:gio_config",
    ]
    deps += [
      "//third_party/boringssl",
      "//third_party/sqlite",
    ]
    libs = [ "dl" ]
  }
}

static_library("sync_services") {
  sources = [
    "packages/sync/windows/Base64.h",
    "packages/sync/windows/RecoveryKit.cpp",
    "packages/sync/windows/RecoveryKit.h",
    "packages/sync/windows/RecoveryKitInternal.h",
    "packages/sync/windows/SyncCrypto.cpp",
    "packages/sync/windows/SyncCrypto.h",
    "packages/sync/windows/SyncService.cpp",
    "packages/sync/windows/SyncService.h",
    "packages/sync/windows/SyncVault.cpp",
    "packages/sync/windows/SyncVault.h",
    "packages/sync/windows/Wordlist.h",
    "packages/sync/windows/vendor/qrcodegen.cpp",
    "packages/sync/windows/vendor/qrcodegen.hpp",
  ]
  configs -= [ "//build/config/compiler:no_exceptions" ]
  configs += [ "//build/config/compiler:exceptions" ]
  include_dirs = [ "vendor" ]
  if (is_win) {
    sources += [
      "packages/sync/windows/RecoveryKitWindows.cpp",
      "packages/sync/windows/SyncCryptoWindows.cpp",
    ]
    defines = [
      "NOMINMAX",
      "WIN32_LEAN_AND_MEAN",
    ]
    libs = [
      "advapi32.lib",
      "bcrypt.lib",
      "crypt32.lib",
      "gdi32.lib",
      "ole32.lib",
      "shell32.lib",
      "user32.lib",
      "uuid.lib",
    ]
  } else if (is_linux) {
    # The shared sync sources use the C++17 UTF-8 std::string path interface.
    cflags_cc = [ "-fno-char8_t" ]
    sources += [
      "packages/sync/linux/RecoveryKitLinux.cpp",
      "packages/sync/linux/SyncCryptoLinux.cpp",
      "packages/sync/linux/SyncKeyStore.cpp",
      "packages/sync/linux/SyncPlatformLinux.cpp",
    ]
    configs += [ ":sync_libsecret" ]
    deps = [
      "//base",
      "//skia",
      "//third_party/boringssl",
      "//ui/base/clipboard",
      "//ui/gfx",
    ]
  }
}

if (is_linux) {
  pkg_config("sync_libsecret") {
    packages = [ "libsecret-1" ]
  }
}
