    "packages/import/windows/Arc.cpp",
    "packages/import/windows/ImportCore.h",
    "packages/import/windows/ImportService.cpp",
    "packages/import/windows/Readers.cpp",
    "packages/import/windows/SQLite.h",
    "packages/import/windows/Secrets.cpp",
    "packages/import/windows/Sessions.cpp",
    "packages/sync/windows/RecoveryKit.cpp",
    "packages/sync/windows/RecoveryKit.h",
    "packages/sync/windows/RecoveryKitInternal.h",
    "packages/sync/windows/RecoveryKitWindows.cpp",
    "packages/sync/windows/SyncCrypto.cpp",
    "packages/sync/windows/SyncCrypto.h",
    "packages/sync/windows/SyncService.cpp",
    "packages/sync/windows/SyncService.h",
    "packages/sync/windows/SyncVault.cpp",
    "packages/sync/windows/SyncVault.h",
    "packages/sync/windows/Wordlist.h",
    "packages/sync/windows/vendor/qrcodegen.cpp",
    "packages/sync/windows/vendor/qrcodegen.hpp",
    "vendor/nlohmann/json.hpp",
  ]
  configs -= [ "//build/config/compiler:no_exceptions" ]
