#
# //chrome/browser/bay: Bay's own code in the Chromium tree. Plain Chromium code
# over Chrome's services, exported as plain C (public/nn_engine.h) and linked by
# both engines: CEF's libcef_static and NNCore's //chrome:chrome_dll (hooks in
# engine/chromium/apply.sh). The repo copy is engine/chromium/src; never edit
# the tree's copy.
#
# One source_set: add your nn_<domain>.{h,cc} to `sources` (sorted) and the
# deps it needs. Nothing in //chrome depends on this target.

assert(is_mac || is_win || is_linux)

source_set("bay") {
  sources = [
    "nn_autofill.cc",
    "nn_autofill.h",
    "nn_bookmarks.cc",
    "nn_browsing_data.cc",
    "nn_browsing_data.h",
    "nn_cookies.cc",
    "nn_cookies.h",
    "nn_dispatch.cc",
    "nn_dispatch.h",
    "nn_downloads.cc",
    "nn_downloads.h",
    "nn_engine.cc",
    "nn_engine.h",
    "nn_extension_import.cc",
    "nn_extension_import.h",
    "nn_extensions.cc",
    "nn_extensions.h",
    "nn_external_apps.cc",
    "nn_external_apps.h",
    "nn_favicons.cc",
    "nn_history.cc",
    "nn_passwords.cc",
    "nn_passwords.h",
    "nn_prefs.cc",
    "nn_prefs.h",
    "nn_process.cc",
    "nn_process.h",
    "nn_reauth.cc",
    "nn_reauth.h",
    "nn_search_engines.cc",
    "nn_search_engines.h",
    "nn_sensitive_args.cc",
    "nn_sensitive_args.h",
    "nn_site_settings.cc",
    "nn_site_settings.h",
    "nn_tab_restore.cc",
    "nn_tabs.cc",
    "nn_tabs.h",
    "nn_zoom.cc",
    "nn_zoom.h",
    "pip/nn_pip_controls.cc",
    "pip/nn_pip_controls.h",
    "pip/nn_pip_platform.h",
    "pip/nn_pip_window.cc",
    "pip/nn_pip_window.h",
    "public/nn_engine.h",
  ]

  deps = [
    "//base",
    "//cc/paint",
    "//chrome/app:generated_resources",
    "//chrome/browser",
    "//chrome/browser/autofill",
    "//chrome/browser/browsing_data:constants",
    "//chrome/browser/content_settings:content_settings_factory",
    "//chrome/browser/device_reauth",
    "//chrome/browser/download",
    "//chrome/browser/extensions",
    "//chrome/browser/extensions/api/passwords_private",
    "//chrome/browser/picture_in_picture",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/search_engines",
    "//chrome/browser/task_manager",
    "//chrome/browser/ui",
    "//chrome/browser/ui/color:color_headers",
    "//chrome/browser/ui/views/overlay",
    "//chrome/common",
    "//chrome/common/extensions/api",
    "//components/autofill/core/browser",
    "//components/autofill/core/common",
    "//components/bookmarks/browser",
    "//components/bookmarks/common",
    "//components/browsing_data/core",
    "//components/component_updater",
    "//components/content_settings/core/browser",
    "//components/content_settings/core/common",
    "//components/crx_file",
    "//components/device_reauth",
    "//components/download/content/public",
    "//components/download/public/common:public",
    "//components/favicon/core",
    "//components/favicon_base",
    "//components/history/core/browser",
    "//components/keyed_service/core",
    "//components/os_crypt/common:switches",
    "//components/password_manager/core/browser",
    "//components/password_manager/core/common",
    "//components/prefs",
    "//components/search_engines",
    "//components/sessions",
    "//components/strings",
    "//components/tab_groups",
    "//components/tabs:public",
    "//components/update_client",
    "//components/value_store",
    "//components/version_info",
    "//content/public/browser",
    "//extensions/browser",
    "//extensions/browser:crx_installer",
    "//extensions/common",
    "//net",
    "//services/media_session/public/cpp",
    "//services/network/public/cpp",
    "//services/network/public/mojom",
    "//skia",
    "//third_party/blink/public/common",
    "//third_party/boringssl",
    "//third_party/leveldatabase",
    "//ui/base",
    "//ui/gfx",
    "//ui/views",
    "//url",
  ]

  if (is_mac) {
    sources += [
      "nn_downloads_mac.mm",
      "nn_external_apps.mm",
      "pip/nn_pip_mac.mm",
    ]

    # Downloads quarantine, external apps, Picture in Picture, and the
    # distribution signature check for reauthentication.
    frameworks = [
      "QuartzCore.framework",
      "AppKit.framework",
      "CoreServices.framework",
      "Security.framework",
    ]
  } else if (is_win) {
    sources += [
      "nn_downloads_win.cc",
      "nn_external_apps_win.cc",
      "pip/nn_pip_win.cc",
    ]
    deps += [
      "//ui/aura",
      "//ui/compositor",
    ]
    libs = [ "shlwapi.lib" ]
  }
}

# Chrome's framework exports only what its lists name; NNCore's framework also
# exports every nn_* call. CEF's framework exports default-visibility symbols
# already, and an exports list there would hide CEF's own API, so only
# //chrome:chrome_dll depends on this.
config("exports_config") {
  if (is_mac) {
    ldflags = [ "-Wl,-exported_symbols_list," +
                rebase_path("nn_engine.exports", root_build_dir) ]
  }
}

group("exports") {
  all_dependent_configs = [ ":exports_config" ]
  public_deps = [ ":bay" ]
}
