module bay.mojom;

// Available only in the browser-owned, top-level chrome://bay document.
// Arguments and results use the generated @bay/platform JSON envelopes.
interface NativeHost {
  GetHostInfo() => (string info_json);
  Invoke(string module_name, string method, string args_json) => (string result_json);
  SetClient(pending_remote<NativeHostClient> client);
};

interface NativeHostClient {
  OnNativeEvent(string module_name, string name, string payload_json);
  OnHostInfoChanged(string info_json);
};
