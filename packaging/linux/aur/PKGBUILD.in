# Maintainer: Krish Kalaria <https://github.com/krishkalaria12>
# Generated by scripts/linux/release.sh from packaging/linux/aur/PKGBUILD.in: edit the template, not the AUR copy.
pkgname=bay-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc="A fast browser with your tabs in a sidebar, on Chromium"
arch=(x86_64)
url="https://bay.krishkalaria.in"
license=(Apache-2.0)
depends=(alsa-lib at-spi2-core gtk3 libcups libdrm libxkbcommon mesa nss xdg-utils)
optdepends=('libsecret: keep saved passwords in GNOME Keyring'
            'kwallet: keep saved passwords in KWallet')
provides=(bay)
conflicts=(bay)
options=(!strip !debug)
source=("https://github.com/krishkalaria12/bay/releases/download/v${pkgver}/bay-${pkgver}-linux-x64.tar.xz")
sha256sums=('@SHA256@')

package() {
  cp -a "bay-${pkgver}/." "${pkgdir}/"
  chmod 4755 "${pkgdir}/opt/bay/chrome_sandbox"
}
